---
import { ClientRouter } from 'astro:transitions';
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import Seo from '~/components/Seo.astro';
import type { PageMeta } from '~/data/site';

interface Props {
  /** Pass the entry from PAGES so title/description/canonical stay in one place. */
  meta: PageMeta;
  noindex?: boolean;
  schema?: unknown[];
}

const { meta, noindex, schema }: Props = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FAF9F7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <Seo
      title={meta.title}
      description={meta.desc}
      path={meta.url}
      noindex={noindex}
      schema={schema}
    />
    {/* Cross-document morphing between pages. Falls back to a normal
        navigation where the View Transition API is unsupported. */}
    <ClientRouter />
    <script is:inline>
      // Mark the document before first paint so reveal targets start hidden.
      // Without JS the class is never added and everything renders visible,
      // so content is never gated behind a script that may not run.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-reveal');
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col overflow-x-hidden bg-surface">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-100 focus:rounded-[2px] focus:bg-accent focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      /*
       * Reveal-on-scroll.
       *
       * A rAF-throttled sweep rather than an IntersectionObserver: an observer
       * only fires on threshold crossings, so a section that moves from below
       * the viewport to above it between two samples — fast scroll, anchor
       * jump, restored scroll position — never reports as intersecting and
       * stays invisible permanently. The sweep asks "is it above the reveal
       * line?", which is also true of anything already scrolled past.
       *
       * Re-runs after each View Transition, since the DOM is replaced.
       */
      function startReveal() {
        const pending = Array.from(
          document.querySelectorAll('[data-reveal], [data-reveal-group], [data-words]'),
        );
        let queued = false;

        function sweep() {
          queued = false;
          const line = window.innerHeight * 0.9;
          for (let i = pending.length - 1; i >= 0; i--) {
            if (pending[i].getBoundingClientRect().top < line) {
              pending[i].classList.add('is-in');
              pending.splice(i, 1);
            }
          }
          if (!pending.length) {
            window.removeEventListener('scroll', request);
            window.removeEventListener('resize', request);
          }
        }

        function request() {
          if (queued) return;
          queued = true;
          requestAnimationFrame(sweep);
        }

        if (pending.length) {
          window.addEventListener('scroll', request, { passive: true });
          window.addEventListener('resize', request, { passive: true });
          window.addEventListener('load', request);
          sweep();
        }
      }

      startReveal();
      document.addEventListener('astro:page-load', startReveal);
    </script>
  </body>
</html>
