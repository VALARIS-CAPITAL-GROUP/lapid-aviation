---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import CtaBand from '~/components/CtaBand.astro';
import { ACCREDITATIONS, BROKER_QUESTIONS, TRIP_BRIEF } from '~/data/content';
import { PAGES } from '~/data/site';
import heroImage from '~/assets/jets-apron.jpg';

const meta = PAGES.vetting;

const checks = [
  {
    n: '01',
    title: 'Licence and certification',
    body: 'We confirm the operator holds a valid Air Operator Certificate for the aircraft and route in question, issued by the relevant civil aviation authority.',
  },
  {
    n: '02',
    title: 'Independent safety audits',
    body: 'We check whether the operator holds a current rating from an independent aviation safety auditor, such as ARGUS or IS-BAO, and review when it was last renewed.',
  },
  {
    n: '03',
    title: 'Insurance',
    body: 'We confirm the operator carries liability insurance appropriate to the aircraft type and the flight, before it is offered as an option.',
  },
  {
    n: '04',
    title: 'Aircraft age and maintenance',
    body: 'We ask when the specific aircraft was last inspected and what maintenance programme it sits under, not just what category it belongs to.',
  },
  {
    n: '05',
    title: 'Crew experience',
    body: 'We ask about crew hours and experience on the specific aircraft type, particularly for longer or more demanding sectors.',
  },
  {
    n: '06',
    title: 'Ongoing review',
    body: 'Operators are not checked once and forgotten. Certifications and ratings are re-confirmed on a regular basis, not only when a booking is made.',
  },
];

const questions = [
  'Which operator is flying this specific aircraft, and under which licence?',
  'Does the operator hold an independent safety rating, and when was it last renewed?',
  'How experienced is the crew on this aircraft type?',
];
---

<Layout meta={meta}>
  <Hero
    image={heroImage}
    alt="Private jets on the apron at dusk"
    eyebrow="Safety &amp; vetting"
    heading="How we vet an operator before it reaches you"
    standfirst="We do not own the aircraft, which means checking who does is the most important thing we do. Every operator behind an option we send you has been through the same checks first."
  />

  <Breadcrumb trail={[{ name: 'How we vet operators', url: meta.url }]} />

  <Section surface="tint" eyebrow="Before an operator is ever offered" heading="The six checks">
    <ol class="grid gap-x-12 gap-y-9 sm:grid-cols-2">
      {
        checks.map((check) => (
          <li class="border-t border-rule pt-5">
            <p class="text-[13px] tabular-nums text-accent">{check.n}</p>
            <h3 class="mt-2 font-display text-[21px] leading-[1.3]">{check.title}</h3>
            <p class="mt-2 text-[14.5px] leading-[1.65] text-body">{check.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section heading="What you can ask us">
    <ol class="border-t border-rule">
      {
        questions.map((question) => (
          <li class="border-b border-rule py-5">
            <p class="font-display text-[19px] leading-[1.4] text-title">{question}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-8 max-w-measure text-[14.5px] leading-[1.7] text-body">
      We are a broker, not a regulator. Final responsibility for the aircraft's airworthiness and
      the flight itself sits with the operator and its licensing authority. Our role is to check
      before we recommend, ask the questions above on your behalf, and tell you plainly if
      something does not check out.
    </p>
  </Section>

  <!--
    The competitor review found the market's trust signals are all badges:
    LunaJets' ARGUS certification, Charter-A's Trustpilot stars. We hold no
    accreditation yet, so competing on badges is not available. What is
    available is the substance behind the best of them — Wyvern's per-trip
    verification — delivered as a commitment we keep rather than a logo.
  -->
  <Section
    surface="tint"
    eyebrow="Before you pay"
    heading="What we send you, without being asked"
    standfirst="The section above lists what you can ask us. This is what arrives anyway, with every set of options, whether or not you think to request it. It is the substance of a per-trip safety verification, which is the one part of the accreditation industry that genuinely helps a passenger."
  >
    <ol class="grid gap-x-12 gap-y-9 sm:grid-cols-2">
      {
        TRIP_BRIEF.map((item) => (
          <li class="border-t border-rule pt-5">
            <p class="text-[13px] tabular-nums text-accent">{item.n}</p>
            <h3 class="mt-2 font-display text-[20px] leading-[1.3]">{item.name}</h3>
            <p class="mt-2 text-[14.5px] leading-[1.65] text-body">{item.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-10 max-w-measure text-[14.5px] leading-[1.7] text-body">
      If any of it is missing from something we send you, ask. Getting it wrong is a failure on
      our side, not an inconvenience on yours.
    </p>
  </Section>

  <!--
    Added after reviewing how the London market handles safety. Two patterns:
    name-dropping an accreditation with no explanation, or "rigorous safety
    protocols" with nothing behind it at all. Neither tells a client that
    auditing an operator and auditing a broker are separate exercises. That
    explanation costs us nothing and is the most useful thing on the page.
  -->
  <Section
    eyebrow="Reading the acronyms"
    heading="What the safety badges actually mean"
    standfirst="Charter websites are full of these, rarely with an explanation. The distinction that matters is the one in the second column: some of them audit the company flying the aircraft, and some audit the company selling you the flight. They are not substitutes for each other."
  >
    <ul class="border-t border-rule">
      {
        ACCREDITATIONS.map((item) => (
          <li class="grid gap-x-10 gap-y-3 border-b border-rule py-6 lg:grid-cols-[minmax(0,1fr)_140px_minmax(0,1.6fr)]">
            <h3 class="font-display text-[19px] leading-[1.3] text-title">{item.name}</h3>
            <p
              class:list={[
                'text-[12px] uppercase tracking-[0.1em]',
                item.audits === 'The broker' ? 'text-accent' : 'text-muted',
              ]}
            >
              Audits {item.audits.toLowerCase()}
            </p>
            <p class="text-[14.5px] leading-[1.65] text-body">{item.body}</p>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 max-w-measure text-[14.5px] leading-[1.7] text-body">
      Where we hold an accreditation ourselves we will name it on this page and you can verify it
      with the issuing body. Until it appears here, assume we do not hold it &mdash; which is the
      same standard we would like you to apply to everyone else you are comparing us against.
    </p>
  </Section>

  <Section
    surface="tint"
    eyebrow="Due diligence"
    heading="Five questions worth asking any charter broker"
    standfirst="Including us. Most of this market will answer the first three comfortably and go quiet on the last two, which is precisely why they are worth asking."
  >
    <ol class="grid gap-x-12 gap-y-9 sm:grid-cols-2">
      {
        BROKER_QUESTIONS.map((question, i) => (
          <li class="border-t border-rule pt-5">
            <p class="text-[13px] tabular-nums text-accent">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-2 font-display text-[19px] leading-[1.35]">{question.name}</h3>
            <p class="mt-3 text-[14.5px] leading-[1.65] text-body">{question.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <CtaBand
    heading="Ask us anything about an operator before you fly."
    cta={{ label: 'Contact us', href: PAGES.contact.url }}
  />
</Layout>
