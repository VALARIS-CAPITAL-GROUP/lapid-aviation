---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import Faq from '~/components/Faq.astro';
import CtaBand from '~/components/CtaBand.astro';
import { PAGES } from '~/data/site';
import { faqSchema, serviceSchema } from '~/lib/schema';
import heroImage from '~/assets/transfers-hero.jpg';

const meta = PAGES.transfers;

const points = [
  {
    title: 'Timed to the flight, not the clock',
    body: 'A delay on either side does not strand you: the car is timed to your flight, not to a fixed slot.',
  },
  {
    title: 'Both ends of the journey',
    body: 'The drive to your departure airport, and the collection on arrival, arranged as one request.',
  },
];

const faqs = [
  {
    q: 'Is the transfer included in the charter price?',
    a: 'Not usually. It is quoted separately, alongside the flight, so you see both costs before confirming.',
  },
  {
    q: "Can you arrange this for a destination you don't fly to often?",
    a: 'Ask. If we do not have an existing partner there, we will say so rather than arrange something we cannot stand behind.',
  },
];

const schema = [
  serviceSchema({
    name: 'Private jet airport transfers',
    description: meta.desc,
    serviceType: 'Chauffeur airport transfer',
  }),
  faqSchema(faqs),
];
---

<Layout meta={meta} schema={schema}>
  <Hero
    image={heroImage}
    alt="A chauffeur holding open the door of an executive car"
    eyebrow="Airport transfers"
    heading="Chauffeur transfers, to and from the aircraft"
    standfirst="A car booked to meet the aircraft, or to take you to it, timed against your actual flight rather than a fixed slot. Arranged through licensed chauffeur partners — we do not own the vehicles."
    primary={{ label: 'Request a charter', href: PAGES.request.url }}
    secondary={{ label: 'Looking for accommodation instead? See resorts, villas & hotels', href: PAGES.resorts.url }}
  />

  <Breadcrumb trail={[{ name: 'Transfers & access', url: meta.url }]} />

  <Section surface="cream" heading="How the timing works">
    <ul class="grid gap-x-10 gap-y-9 sm:grid-cols-2">
      {
        points.map((point) => (
          <li class="border-t border-navy/15 pt-5">
            <h3 class="font-serif text-[21px] leading-[1.3]">{point.title}</h3>
            <p class="mt-3 text-[14.5px] leading-[1.65] text-muted">{point.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section heading="Common questions">
    <Faq items={faqs} />
  </Section>

  <CtaBand heading="Tell us the flight, and where the car needs to be." />
</Layout>
