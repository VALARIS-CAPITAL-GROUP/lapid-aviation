---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import CtaBand from '~/components/CtaBand.astro';
import { AIRPORTS } from '~/data/content';
import { PAGES } from '~/data/site';
import heroImage from '~/assets/london-hero.jpg';

const meta = PAGES.airportsHub;

// Only Farnborough has a verified page of its own so far.
const airportHref = (name: string) =>
  name === 'Farnborough' ? PAGES.farnborough.url : null;
---

<Layout meta={meta} noindex>
  <Hero
    image={heroImage}
    alt="The London skyline and the River Thames"
    eyebrow="London private aviation airports"
    heading="Airports we use around London"
    standfirst="The right airport depends on where you're starting from, the aircraft, and how the ground journey compares to the time in the air. Full detail is published once verified — Farnborough is live now."
  />

  <Breadcrumb trail={[{ name: 'Airports', url: meta.url }]} />

  <Section surface="tint" heading="The six fields">
    <ul class="grid gap-x-10 gap-y-7 sm:grid-cols-2 lg:grid-cols-3">
      {
        AIRPORTS.map((airport) => {
          const href = airportHref(airport.name);
          return (
            <li class="border-t border-rule pt-5">
              <h3 class="font-display text-[21px]">
                {href ? (
                  <a href={href} class="text-title transition-colors hover:text-accent">
                    {airport.name}
                  </a>
                ) : (
                  airport.name
                )}
              </h3>
              <p class="mt-2 text-[14.5px] leading-[1.65] text-body">{airport.note}</p>
              {href && (
                <a
                  href={href}
                  class="mt-3 inline-block text-[13px] font-medium text-accent transition-colors hover:text-title"
                >
                  Charter from {airport.name} &rarr;
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
  </Section>

  <CtaBand
    heading="Not sure which airport suits the trip?"
    body="Tell us where you are starting from and we will weigh the ground journey against the flight."
  />
</Layout>
