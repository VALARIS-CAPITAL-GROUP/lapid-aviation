---
import { Picture } from 'astro:assets';
import Layout from '~/layouts/Layout.astro';
import Section from '~/components/Section.astro';
import QuoteBar from '~/components/QuoteBar.astro';
import { AIRPORTS, JOURNEY, ROUTES } from '~/data/content';
import { PAGES } from '~/data/site';
import { serviceSchema } from '~/lib/schema';
import heroImage from '~/assets/home-hero.png';

const meta = PAGES.home;

// "Three ways to charter" — the honest-comparison section.
const alternatives = [
  {
    kicker: 'Book direct with an operator',
    title: 'Their fleet, their answer',
    body: 'An operator will always recommend an aircraft it owns. If the right one for your sector is parked with somebody else, you will not hear about it.',
  },
  {
    kicker: 'An online booking platform',
    title: 'Fast until something moves',
    body: 'Instant pricing is a real advantage. Then the meeting shifts, the aircraft goes technical, or the luggage does not fit, and there is nobody who knows your trip.',
  },
  {
    kicker: 'Lapid Aviation',
    title: 'A broker with no fleet to defend',
    body: 'We hold no aircraft, so we have no reason to steer you. We search the market for your specific flight, present the options with their drawbacks stated, and stay on the line when the plan changes.',
    highlight: true,
  },
];

const differentiators = [
  {
    title: 'You speak to the person doing the work',
    body: 'Not a switchboard, not a shared inbox. The broker who quoted your flight is the one who answers on the morning of departure.',
  },
  {
    title: 'Options, not a single price',
    body: 'You see the shortlist with what each aircraft and airport costs you in time, money and comfort, so the decision is yours on the facts.',
  },
  {
    title: 'Built around your day',
    body: 'The departure time, the airport, the aircraft — all chosen to fit your schedule, not the other way round.',
  },
  {
    title: 'Every operator checked first',
    body: 'Flights are operated by appropriately licensed third-party operators, reviewed before an option reaches you rather than after.',
  },
];

const standard = [
  {
    title: 'Personal review',
    body: 'Every enquiry is read and answered by a person, not routed through a quote engine.',
  },
  {
    title: 'Licensed operators only',
    body: 'Every option comes from an appropriately licensed third-party operator, checked before it reaches you.',
    link: { label: 'See how we vet', href: PAGES.vetting.url },
  },
  {
    title: 'One person, start to finish',
    body: 'The broker who quotes your flight stays on it through to boarding and back.',
  },
  {
    title: 'Discreet by default',
    body: 'Your details, your itinerary and your preferences are handled in confidence, not shared beyond what a flight requires.',
  },
];

const services = [
  {
    title: 'Private jet charter',
    body: 'Point-to-point flights from the London airports, sized to the group and the distance — from short European hops to ultra-long-range sectors.',
    href: PAGES.jets.url,
    cta: 'Private jets',
  },
  {
    title: 'Helicopter charter',
    body: 'Transfers, events and estate arrivals in and around London, including connections onto a waiting jet.',
    href: PAGES.helicopter.url,
    cta: 'Helicopters',
  },
  {
    title: 'Business aviation',
    body: 'Recurring corporate travel, multi-city itineraries and roadshows, handled as a standing arrangement rather than one-off bookings.',
    href: PAGES.business.url,
    cta: 'Business aviation',
  },
  {
    title: 'Airport transfers',
    body: 'Chauffeur cars timed to your flight, at either end of the journey, arranged through licensed partners.',
    href: PAGES.transfers.url,
    cta: 'Transfers',
  },
  {
    title: 'Resorts, villas & hotels',
    body: "Introductions to where you're staying, for the trip either side of the flight, through trusted destination partners.",
    href: PAGES.resorts.url,
    cta: 'Resorts & villas',
  },
];

const journal = [
  {
    kicker: 'Cost',
    title: 'How much does it cost to charter a private jet?',
    body: 'What actually moves the number, and why charter is quoted per flight rather than per seat.',
    href: PAGES.cost.url,
  },
  {
    kicker: 'Guide',
    title: 'First time flying private',
    body: 'What happens from the moment you arrive at the terminal, and what nobody tells you in advance.',
    href: PAGES.firsttime.url,
  },
  {
    kicker: 'Business',
    title: 'How private aviation saves executives time',
    body: 'Where the hours come back, and how to tell whether a schedule justifies the aircraft.',
    href: PAGES.business.url,
  },
];

// Only Geneva has a full route page in this phase; the rest route to the
// jets page rather than to a 404.
const routeHref = (route: (typeof ROUTES)[number]) =>
  route.key === 'geneva' ? PAGES.routeGeneva.url : PAGES.jets.url;

const schema = [
  serviceSchema({
    name: 'Private jet and helicopter charter',
    description: meta.desc,
    serviceType: 'Private jet charter',
  }),
];
---

<Layout meta={meta} schema={schema}>
  <!-- Hero -->
  <section class="pt-[clamp(40px,6vw,76px)]">
    <div class="shell">
      <div class="grid items-center gap-[clamp(32px,5vw,64px)] lg:grid-cols-[1.05fr_1fr]">
        <div>
          <p class="eyebrow">London private aviation</p>
          <h1 class="mt-6 text-display">Your schedule should belong to you.</h1>
          <p class="mt-7 max-w-measure text-[19px] leading-[1.6] text-muted">
            Lapid Aviation arranges private jet and helicopter charter from London. One broker,
            the right aircraft for the route, and a departure that fits the day you actually
            need to fly.
          </p>
        </div>
        <Picture
          src={heroImage}
          alt="A private jet on the tarmac at a London airport at dusk"
          widths={[480, 760, 1100]}
          sizes="(min-width: 1024px) 46vw, 100vw"
          formats={['avif']}
          fallbackFormat="webp"
          loading="eager"
          fetchpriority="high"
          class="aspect-3/2 w-full rounded-[3px] object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Enquiry opener -->
  <section class="pt-[clamp(36px,5vw,52px)]">
    <div class="shell">
      <QuoteBar />
    </div>
  </section>

  <!-- Why Lapid -->
  <Section
    eyebrow="Why Lapid"
    heading="There are three ways to charter a jet. Only one of them works for you."
    standfirst="We would rather explain the trade-offs than pretend they do not exist. Here is what the alternatives get right, and where they leave you."
  >
    <ul class="grid gap-5 lg:grid-cols-3">
      {
        alternatives.map((item) => (
          <li
            class:list={[
              'rounded-[3px] border p-[clamp(22px,2.6vw,30px)]',
              item.highlight
                ? 'border-copper/40 bg-cream'
                : 'border-navy/12 bg-transparent',
            ]}
          >
            <p class:list={['eyebrow', !item.highlight && '!text-faint']}>{item.kicker}</p>
            <h3 class="mt-4 font-serif text-[22px] leading-[1.25]">{item.title}</h3>
            <p class="mt-3 text-[14.5px] leading-[1.65] text-muted">{item.body}</p>
          </li>
        ))
      }
    </ul>

    <ul class="mt-5 grid gap-x-10 gap-y-8 border-t border-line pt-10 sm:grid-cols-2">
      {
        differentiators.map((item) => (
          <li>
            <h3 class="font-serif text-[20px] leading-[1.3]">{item.title}</h3>
            <p class="mt-2 max-w-measure text-[14.5px] leading-[1.65] text-muted">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- The journey -->
  <Section
    surface="navy"
    eyebrow="From this page to the aircraft"
    heading="Seven stages. You're involved in three."
    standfirst="Charter goes wrong in the gaps between people. This is the whole sequence, and who is holding it at each point."
  >
    <ol class="border-t border-white/12">
      {
        JOURNEY.map((step) => {
          const yours = step.who === 'YOU' || step.who === 'YOU DECIDE';
          return (
            <li class="border-b border-white/12">
              <details class="group">
                <summary
                  class="grid cursor-pointer list-none grid-cols-[auto_1fr_auto] items-start gap-x-5 gap-y-2 py-6 [&::-webkit-details-marker]:hidden sm:grid-cols-[auto_1fr_auto_auto]"
                >
                  <span
                    class="font-serif text-[15px] tabular-nums"
                    style={`color:${step.colour}`}
                    aria-hidden="true"
                  >
                    {step.n}
                  </span>
                  <span class="font-serif text-[20px] leading-[1.3] text-sand">{step.title}</span>
                  <span
                    class:list={[
                      'hidden text-[9.5px] font-semibold tracking-[0.16em] uppercase sm:block',
                      yours ? 'text-copper-light' : 'text-faint',
                    ]}
                  >
                    {yours ? 'Your move' : 'We handle it'}
                  </span>
                  <span
                    class="shrink-0 text-[18px] leading-none text-copper-light transition-transform duration-200 group-open:rotate-45"
                    aria-hidden="true">+</span
                  >
                </summary>
                <div class="col-start-2 max-w-measure pb-7 sm:pl-10">
                  <p class="text-[15px] leading-[1.68] text-[#a9b2bf]">{step.body}</p>
                  <p class="mt-3 text-[14px] leading-[1.65] text-faint">{step.more}</p>
                </div>
              </details>
            </li>
          );
        })
      }
    </ol>
  </Section>

  <!-- The Lapid standard -->
  <Section surface="cream" eyebrow="The Lapid standard" heading="What every enquiry is built on">
    <ul class="grid gap-x-10 gap-y-9 sm:grid-cols-2 lg:grid-cols-4">
      {
        standard.map((item) => (
          <li class="border-t border-navy/15 pt-5">
            <h3 class="font-serif text-[20px] leading-[1.3]">{item.title}</h3>
            <p class="mt-3 text-[14.5px] leading-[1.65] text-muted">{item.body}</p>
            {item.link && (
              <a
                href={item.link.href}
                class="mt-3 inline-block text-[13px] text-copper transition-colors hover:text-navy"
              >
                {item.link.label} &rarr;
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- What we arrange -->
  <!-- The design's heading said "Four ways" above five cards; corrected to five. -->
  <Section eyebrow="What we arrange" heading="Five ways we take care of the journey.">
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <li>
            <a
              href={service.href}
              class="group flex h-full flex-col rounded-[3px] border border-navy/12 p-[clamp(22px,2.6vw,30px)] transition-all duration-200 ease-(--ease-out-expo) hover:-translate-y-[3px] hover:border-copper/40 hover:bg-cream hover:shadow-[0_14px_28px_rgba(16,27,45,0.08)]"
            >
              <h3 class="font-serif text-[22px] leading-[1.25]">{service.title}</h3>
              <p class="mt-3 flex-1 text-[14.5px] leading-[1.65] text-muted">{service.body}</p>
              <span class="mt-5 text-[13px] font-medium text-copper">
                {service.cta}
                <span
                  class="inline-block transition-transform group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  &nbsp;&rarr;
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Departure points -->
  <Section eyebrow="Departure points" heading="Six ways out of the city." surface="cream">
    <ul class="grid gap-x-10 gap-y-7 sm:grid-cols-2 lg:grid-cols-3">
      {
        AIRPORTS.map((airport) => (
          <li class="border-t border-navy/15 pt-5">
            <h3 class="font-serif text-[20px]">{airport.name}</h3>
            <p class="mt-2 text-[14.5px] leading-[1.65] text-muted">{airport.note}</p>
          </li>
        ))
      }
    </ul>
    <a
      href={PAGES.airportsHub.url}
      class="mt-10 inline-block text-[13px] font-medium text-copper transition-colors hover:text-navy"
    >
      All airports &rarr;
    </a>
  </Section>

  <!-- Routes -->
  <Section
    eyebrow="Routes"
    heading="Where we fly most."
    standfirst="Distances and flight times are published only once verified against operator data."
  >
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        ROUTES.map((route) => (
          <li>
            <a
              href={routeHref(route)}
              class="group block h-full rounded-[3px] border border-navy/12 p-6 transition-all duration-200 ease-(--ease-out-expo) hover:-translate-y-[3px] hover:border-copper/40 hover:bg-cream"
            >
              <p class="eyebrow !text-faint">{route.cat}</p>
              <h3 class="mt-3 font-serif text-[21px]">
                London &rarr; {route.to}
              </h3>
              <p class="mt-2 text-[13.5px] text-muted">{route.aircraft}</p>
              <p class="mt-3 text-[13.5px] leading-[1.6] text-muted">{route.note}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Journal -->
  <Section
    surface="cream"
    eyebrow="Journal"
    heading="Straight answers to the questions people actually ask before their first charter."
  >
    <ul class="grid gap-5 lg:grid-cols-3">
      {
        journal.map((entry) => (
          <li>
            <a
              href={entry.href}
              class="group flex h-full flex-col rounded-[3px] border border-navy/12 bg-sand p-[clamp(22px,2.6vw,30px)] transition-all duration-200 ease-(--ease-out-expo) hover:-translate-y-[3px] hover:border-copper/40"
            >
              <p class="eyebrow">{entry.kicker}</p>
              <h3 class="mt-4 font-serif text-[21px] leading-[1.28]">{entry.title}</h3>
              <p class="mt-3 flex-1 text-[14.5px] leading-[1.65] text-muted">{entry.body}</p>
              <span class="mt-5 text-[13px] font-medium text-copper">Read &rarr;</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Closing CTA -->
  <Section narrow={false}>
    <div
      class="rounded-[3px] bg-navy px-[clamp(24px,4vw,56px)] py-[clamp(36px,5vw,64px)] text-center"
    >
      <h2 class="mx-auto max-w-[620px] text-heading !text-sand">
        Tell us the route and the day.
      </h2>
      <p class="mx-auto mt-5 max-w-[520px] text-[15.5px] leading-[1.65] text-[#a9b2bf]">
        No commitment. We reply with options, not a hard sell.
      </p>
      <a
        href={PAGES.request.url}
        class="mt-8 inline-block rounded-[2px] bg-copper px-8 py-4 text-[11.5px] font-semibold tracking-[0.13em] text-white uppercase transition-all duration-200 ease-(--ease-out-expo) hover:-translate-y-[2px] hover:bg-copper-light hover:shadow-[0_10px_22px_rgba(0,0,0,0.3)]"
      >
        Request a charter
      </a>
    </div>
  </Section>
</Layout>
