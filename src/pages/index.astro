---
import { Image } from 'astro:assets';
import Layout from '~/layouts/Layout.astro';
import Hero from '~/components/Hero.astro';
import Split from '~/components/Split.astro';
import Section from '~/components/Section.astro';
import Pillars from '~/components/Pillars.astro';
import JourneyArc from '~/components/JourneyArc.astro';
import Ecosystem from '~/components/Ecosystem.astro';
import Collections from '~/components/Collections.astro';
import QuoteBar from '~/components/QuoteBar.astro';
import CtaBand from '~/components/CtaBand.astro';
import { JOURNEY_ARC, SAMPLE_JOURNEYS } from '~/data/content';
import { PAGES } from '~/data/site';
import { serviceSchema } from '~/lib/schema';
import homeHero from '~/assets/home-hero.jpg';
import cabinWork from '~/assets/cabin-work.jpg';
import hangar from '~/assets/hangar.jpg';
import resortsHero from '~/assets/resorts-hero.jpg';
import jetsHero from '~/assets/jets-hero.jpg';

const meta = PAGES.home;

/**
 * The home page is ordered as an argument, not as a service list:
 *
 *   what you are actually buying (pillars)
 *   -> what that looks like as one journey (arc)
 *   -> the aviation that starts it (split)
 *   -> the world beyond it (ecosystem)
 *   -> where you would stay (collections)
 *   -> journeys made concrete (worked examples)
 *   -> how it is held together (systems)
 *   -> the invitation (enquiry)
 *
 * The competitor comparison that used to sit third has moved to /about/. It
 * argued against other brokers, which is a sales move, and the brief asks for
 * an invitation rather than a funnel.
 */

const standard = [
  {
    title: 'One relationship',
    body: 'The person who plans the journey is the person who answers on the morning of departure, and the one who moves the car when the slot shifts.',
  },
  {
    title: 'Licensed operators only',
    body: 'Every aircraft comes from an appropriately licensed third-party operator, checked for your specific flight before it reaches you.',
    link: { label: 'How we vet', href: PAGES.vetting.url },
  },
  {
    title: 'Discreet by default',
    body: 'Your movements, your household and your preferences stay with us. Nothing is shared beyond what a flight or a booking actually requires.',
  },
  {
    title: 'Nothing invented',
    body: 'Where we hold a direct relationship we say so. Where we are making an introduction, we say that instead — and we do not promise a landing site before it is confirmed.',
  },
];

const schema = [
  serviceSchema({
    name: 'Private jet charter and travel concierge',
    description: meta.desc,
    serviceType: 'Private jet charter',
  }),
];
---

<Layout meta={meta} schema={schema}>
  <Hero
    image={homeHero}
    alt="A line of private jets on the apron at dusk"
    eyebrow="Private aviation & travel concierge"
    heading="Tell us where you want to be."
    standfirst="Lapid arranges the aircraft, and everything on either side of it. One relationship holding the flight, the car, the house and the reason you went."
    size="full"
    primary={{ label: 'Request a Charter', href: PAGES.request.url }}
    secondary={{ label: 'Plan Your Journey', href: PAGES.privateWorld.url }}
  />

  <!-- What the client is actually buying, before any mention of aircraft. -->
  <Section
    eyebrow="Why people fly this way"
    heading="Nobody charters an aircraft because they want an aircraft."
    standfirst="They want the day back. Four things sit underneath every journey we arrange, and they shape every decision we make on your behalf."
  >
    <Pillars />
  </Section>

  <!-- The journey as one continuous thing, over the hangar frame. -->
  <section class="relative isolate overflow-hidden bg-charcoal">
    <!--
      Decorative only, hence the empty alt. Goes through <Image> rather than
      `hangar.src` so it is served as a sized WebP — the raw import shipped the
      full 608 KB JPEG.
    -->
    <Image
      src={hangar}
      alt=""
      aria-hidden="true"
      widths={[640, 1280, 1920]}
      sizes="100vw"
      format="webp"
      quality={55}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 -z-20 size-full object-cover opacity-20"
    />
    <div class="shell py-[clamp(72px,10vw,150px)]">
      <div data-reveal class="max-w-[820px]">
        <p class="eyebrow">One journey</p>
        <span class="gold-rule mt-5" aria-hidden="true"></span>
        <h2 class="mt-7 text-heading">
          From your door to the reason you travelled, without a handover.
        </h2>
        <p class="mt-6 max-w-measure text-[17px] leading-[1.7] text-ash">
          Most trips lose their time in the gaps between suppliers — the car that
          does not know the flight, the property that expects you at three. We hold
          the whole line instead.
        </p>
      </div>

      <div data-reveal style="--reveal-delay:140ms" class="mt-[clamp(48px,6vw,84px)]">
        <JourneyArc steps={JOURNEY_ARC} />
      </div>
    </div>
  </section>

  <Split
    image={cabinWork}
    alt="Two passengers working at a table in a private jet cabin"
    eyebrow="Where it starts"
    heading="Aviation is the way in."
    surface="obsidian"
    flip
  >
    <p>
      We hold no aircraft, so we have no fleet to defend and no reason to steer you
      toward one. We search the market for the flight in front of us, and present
      the options with their trade-offs written down.
    </p>
    <p>
      That is also why the rest of the journey sits with us rather than with a
      separate agency. The people who chose the airport are the people who brief
      the car.
    </p>
    <a href={PAGES.jets.url} class="cta-text">Private jet charter &rarr;</a>
  </Split>

  <!-- The reveal: the ecosystem beyond the aircraft. -->
  <Section
    surface="charcoal"
    eyebrow="The private world of Lapid"
    heading="Seven parts of one journey."
    standfirst="Private aviation is the entry point. Beyond it sits the ground, the stay and the reason for the trip — reached through one number rather than eight separate arrangements."
  >
    <Ecosystem />
    <div class="mt-12" data-reveal>
      <a href={PAGES.privateWorld.url} class="cta-ghost">Explore the Private World</a>
    </div>
  </Section>

  <Split
    image={resortsHero}
    alt="An infinity pool and terrace looking out over a lake and mountains"
    eyebrow="Where you stay"
    heading="A collection, not a catalogue."
    surface="obsidian"
  >
    <p>
      A short list of resorts, villas and hotels at the destinations we fly to most,
      approached directly rather than through a booking engine. That is what makes a
      late arrival or a held suite a conversation instead of a form.
    </p>
    <p>
      Organised the way people actually think about a trip — by the kind of place
      they want to wake up in.
    </p>
    <a href={PAGES.hotels.url} class="cta-text">Discover the Collection &rarr;</a>
  </Split>

  <Section eyebrow="Curated collections" heading="Where would you like to wake up?">
    <Collections />
  </Section>

  <!-- Journeys made concrete. -->
  <Section
    surface="charcoal"
    eyebrow="Journeys"
    heading="What it looks like when the pieces connect."
    standfirst="Three shapes we arrange often. Illustrative rather than packaged — yours would be built around your dates."
  >
    <ul class="grid gap-px overflow-hidden bg-hair lg:grid-cols-3" data-reveal-group>
      {
        SAMPLE_JOURNEYS.map((journey) => (
          <li class="flex flex-col bg-obsidian p-[clamp(24px,2.8vw,36px)]">
            <p class="eyebrow !text-slate">{journey.kicker}</p>
            <h3 class="mt-5 font-display text-[clamp(21px,1.9vw,26px)] leading-[1.2]">
              {journey.title}
            </h3>

            {/* The route as a wrapping chain rather than a diagram, so it stays
                legible at any width. */}
            <ol class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-2">
              {journey.steps.map((step, i) => (
                <li class="flex items-center gap-2">
                  <span class="text-[12px] tracking-[0.04em] text-paper">{step}</span>
                  {i < journey.steps.length - 1 && (
                    <span aria-hidden="true" class="text-[11px] text-gold/70">
                      &rarr;
                    </span>
                  )}
                </li>
              ))}
            </ol>

            <p class="mt-6 flex-1 text-[14.5px] leading-[1.7] text-ash">{journey.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section eyebrow="The Lapid standard" heading="What every enquiry is built on.">
    <ul class="grid gap-x-10 gap-y-9 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {
        standard.map((item) => (
          <li class="border-t border-white/12 pt-6">
            <h3 class="font-display text-[20px] leading-[1.3]">{item.title}</h3>
            <p class="mt-3 text-[14.5px] leading-[1.7] text-ash">{item.body}</p>
            {item.link && (
              <a href={item.link.href} class="cta-text mt-4">
                {item.link.label} &rarr;
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- The invitation. Placed at the end rather than lifted over the hero: a
       four-field form overlapping the opening image read as a booking engine,
       which is the one thing the brand is not. -->
  <Section
    surface="charcoal"
    id="enquire"
    eyebrow="Private access"
    heading="Start with a destination, or just a date."
    standfirst="No account and no commitment. Tell us roughly what you have in mind and a broker replies with what is genuinely possible."
  >
    <div class="max-w-[760px]">
      <QuoteBar />
    </div>
  </Section>

  <CtaBand
    image={jetsHero}
    alt="Private jets parked on an open apron"
    heading="Where would you like to be?"
    body="Tell us the destination and the day. We will hold everything in between."
  />
</Layout>
