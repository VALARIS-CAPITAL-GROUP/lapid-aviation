---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import Faq from '~/components/Faq.astro';
import CtaBand from '~/components/CtaBand.astro';
import ResearchNote from '~/components/ResearchNote.astro';
import { PAGES } from '~/data/site';
import { faqSchema } from '~/lib/schema';
import heroImage from '~/assets/geneva-hero.jpg';

const meta = PAGES.routeGeneva;

// "To verify" is deliberate: distance and flight time are published only once
// checked against operator data, per the design's research flags.
const overview = [
  { label: 'Origin', value: 'London' },
  { label: 'Destination', value: 'Geneva' },
  { label: 'Distance', value: 'To verify', unverified: true },
  { label: 'Flight time', value: 'To verify', unverified: true },
  { label: 'Typical aircraft', value: 'Light – midsize' },
];

const departureAirports = ['Farnborough', 'Biggin Hill', 'London City', 'Luton'];

const uses = [
  {
    title: 'Business travel',
    body: 'A morning meeting in Geneva and back in London for the evening, without a scheduled layover eating the middle of the day.',
  },
  {
    title: 'Leisure travel',
    body: 'The usual connection point for the Alps in ski season, with luggage for boards, boots and bags handled without an allowance.',
  },
  {
    title: 'Family travel',
    body: 'No transfers, no queues, and departure times that work around school runs and nap schedules rather than a timetable.',
  },
  {
    title: 'First-time flyers',
    body: 'A short, familiar route is a straightforward first private flight.',
    link: { label: 'What to expect', href: PAGES.firsttime.url },
  },
];

const faqs = [
  {
    q: 'Can I fly into Geneva for a ski connection?',
    a: 'Yes, it is one of the most common uses of this route. Ground transfer onward into the Alps is arranged alongside the flight.',
  },
  {
    q: 'Is a same-day return practical?',
    a: 'Often, for a single meeting. Crew duty limits and airport hours set the boundaries, and we check both before confirming a same-day plan.',
  },
];

const schema = [faqSchema(faqs)];
---

<Layout meta={meta} schema={schema}>
  <Hero
    image={heroImage}
    alt="An aerial view of the Alps above a misty lake"
    eyebrow="European route"
    heading="Private jet charter from London to Geneva"
    standfirst="Geneva is one of the busiest private aviation routes in Europe, used for banking meetings, ski connections and onward travel into the Alps. Charter removes the layover through Zurich or Basel that scheduled airlines often add, and lets you choose the airport at either end."
    primary={{ label: 'Request this route', href: PAGES.request.url }}
  />

  <Breadcrumb
    trail={[
      { name: 'Routes', url: PAGES.jets.url },
      { name: 'London to Geneva', url: meta.url },
    ]}
  />

  <Section surface="tint" eyebrow="Journey overview" heading="The route at a glance">
    <dl class="grid gap-x-8 gap-y-6 sm:grid-cols-3 lg:grid-cols-5">
      {
        overview.map((item) => (
          <div class="border-t border-rule pt-4">
            <dt class="eyebrow !text-muted">{item.label}</dt>
            <dd
              class:list={[
                'mt-3 font-display text-[20px]',
                item.unverified ? 'text-muted italic' : 'text-title',
              ]}
            >
              {item.value}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-12 grid gap-10 lg:grid-cols-2">
      <div class="border-t border-rule pt-5">
        <h3 class="eyebrow">Departure airports</h3>
        <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-[15px] text-body">
          {departureAirports.map((airport) => <li>{airport}</li>)}
        </ul>
      </div>
      <div class="border-t border-rule pt-5">
        <h3 class="eyebrow">Arrival airport</h3>
        <p class="mt-4 text-[15px] leading-[1.6] text-body">
          Geneva Airport (GVA), with a dedicated business aviation terminal.
        </p>
      </div>
    </div>

    <ResearchNote>
      Distance, flight time and the Geneva terminal detail to be verified against operator data
      before these figures are published.
    </ResearchNote>
  </Section>

  <Section heading="Which aircraft for this route">
    <p class="max-w-[760px] text-[16px] leading-[1.7] text-body">
      Light jets cover this sector comfortably for small groups; a midsize aircraft adds cabin
      space and luggage room, useful for ski trips or a full team.
    </p>
    <a
      href={PAGES.aircraft.url}
      class="mt-6 inline-block text-[13px] font-medium text-accent transition-colors hover:text-title"
    >
      See all aircraft categories &rarr;
    </a>
  </Section>

  <Section surface="tint" heading="Who flies it">
    <ul class="grid gap-x-10 gap-y-9 sm:grid-cols-2">
      {
        uses.map((use) => (
          <li class="border-t border-rule pt-5">
            <h3 class="font-display text-[21px] leading-[1.3]">{use.title}</h3>
            <p class="mt-3 text-[14.5px] leading-[1.65] text-body">{use.body}</p>
            {use.link && (
              <a
                href={use.link.href}
                class="mt-3 inline-block text-[13px] font-medium text-accent transition-colors hover:text-title"
              >
                {use.link.label} &rarr;
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section heading="Cost">
    <p class="max-w-[760px] text-[16px] leading-[1.7] text-body">
      Priced on the aircraft, the day and where it starts from, not a fixed rate for the route.
    </p>
    <a
      href={PAGES.cost.url}
      class="mt-6 inline-block text-[13px] font-medium text-accent transition-colors hover:text-title"
    >
      See what moves the number &rarr;
    </a>
  </Section>

  <Section surface="tint" heading="Route questions">
    <Faq items={faqs} />
  </Section>

  <CtaBand
    heading="Request this route."
    cta={{ label: 'Request this route', href: PAGES.request.url }}
  />
</Layout>
