---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import CtaBand from '~/components/CtaBand.astro';
import { PAGES } from '~/data/site';
import heroImage from '~/assets/hangar.jpg';

const meta = PAGES.about;

// The design's team slots were placeholders with no names or photography.
// Kept as-is rather than inventing people.
const team = [
  { role: 'Managing Director', name: 'To be introduced' },
  { role: 'Private Aviation Broker', name: 'To be introduced' },
  { role: 'Private Aviation Broker', name: 'To be introduced' },
];

const principles = [
  {
    title: 'What a broker does',
    body: 'We take a brief, search the market, check the operator, and manage the arrangement from enquiry to arrival. The aircraft is never ours — it belongs to the operator flying it.',
  },
  {
    title: 'Why that matters',
    body: 'An operator recommends its own aircraft. We have none to recommend, so the shortlist we send you is built around your flight, not our fleet.',
  },
  {
    title: 'Who you deal with',
    body: 'The broker who quotes your flight stays on it through to boarding. Company registration and regulatory details are published here once confirmed.',
  },
];
---

<Layout meta={meta}>
  <Hero
    image={heroImage}
    alt="Private jets inside a hangar"
    eyebrow="About Lapid Aviation"
    heading="An independent broker, not an operator"
    standfirst="Lapid Aviation arranges private jet and helicopter charter from London through appropriately licensed third-party operators. We own no aircraft, so there is no fleet steering the advice you get — only the route, the group and the day."
  />

  <Breadcrumb trail={[{ name: 'About', url: meta.url }]} />

  <Section surface="charcoal" eyebrow="The team" heading="Who you will be speaking to">
    <ul class="grid gap-6 sm:grid-cols-3">
      {
        team.map((member) => (
          <li class="border-t border-white/12 pt-5">
            {/* Placeholder block: team photography was never supplied. */}
            <div
              class="mb-5 flex aspect-4/5 items-center justify-center rounded-[3px] border border-dashed border-white/16 bg-charcoal/4 text-[11px] tracking-[0.16em] text-slate uppercase"
              aria-hidden="true"
            >
              Photo to follow
            </div>
            <p class="eyebrow !text-slate">{member.role}</p>
            <p class="mt-3 font-display text-[20px] text-paper">{member.name}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section heading="How we work">
    <ul class="grid gap-x-10 gap-y-9 lg:grid-cols-3">
      {
        principles.map((item) => (
          <li class="border-t border-hair pt-5">
            <h3 class="font-display text-[21px] leading-[1.3]">{item.title}</h3>
            <p class="mt-3 text-[14.5px] leading-[1.65] text-ash">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <CtaBand
    heading="Questions before your first enquiry?"
    cta={{ label: 'Contact us', href: PAGES.contact.url }}
  />
</Layout>
