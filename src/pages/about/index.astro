---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import CtaBand from '~/components/CtaBand.astro';
import { PAGES } from '~/data/site';
import heroImage from '~/assets/hangar.jpg';

const meta = PAGES.about;

// The design's team slots were placeholders with no names or photography.
// Kept as-is rather than inventing people.
const team = [
  { role: 'Managing Director', name: 'To be introduced' },
  { role: 'Private Aviation Broker', name: 'To be introduced' },
  { role: 'Private Aviation Broker', name: 'To be introduced' },
];

/**
 * The three-way comparison, moved here from the home page.
 *
 * It argues against the alternatives, which is a sales move and reads badly as
 * the third thing a visitor sees. On an "about" page, where someone has gone
 * looking for how the company works, the same argument is useful rather than
 * pushy — so it was relocated rather than deleted.
 */
const alternatives = [
  {
    kicker: 'Book direct with an operator',
    title: 'Their fleet, their answer',
    body: 'An operator will always recommend an aircraft it owns. If the right one for your sector is parked with somebody else, you will not hear about it.',
  },
  {
    kicker: 'An online booking platform',
    title: 'Fast until something moves',
    body: 'Instant pricing is a real advantage. Then the meeting shifts, the aircraft goes technical, or the luggage does not fit, and there is nobody who knows your trip.',
  },
  {
    kicker: 'Lapid Aviation',
    title: 'A broker with no fleet to defend',
    body: 'We hold no aircraft, so we have no reason to steer you. We search the market for your specific flight, present the options with their drawbacks stated, and stay on the line when the plan changes.',
    highlight: true,
  },
];

const principles = [
  {
    title: 'What a broker does',
    body: 'We take a brief, search the market, check the operator, and manage the arrangement from enquiry to arrival. The aircraft is never ours — it belongs to the operator flying it.',
  },
  {
    title: 'Why that matters',
    body: 'An operator recommends its own aircraft. We have none to recommend, so the shortlist we send you is built around your flight, not our fleet.',
  },
  {
    title: 'Who you deal with',
    body: 'The broker who quotes your flight stays on it through to boarding. Company registration and regulatory details are published here once confirmed.',
  },
];
---

<Layout meta={meta}>
  <Hero
    image={heroImage}
    alt="Private jets inside a hangar"
    eyebrow="About Lapid Aviation"
    heading="An independent broker, not an operator"
    standfirst="Lapid Aviation arranges private jet and helicopter charter from London through appropriately licensed third-party operators. We own no aircraft, so there is no fleet steering the advice you get — only the route, the group and the day."
  />

  <Breadcrumb trail={[{ name: 'About', url: meta.url }]} />

  <Section surface="tint" eyebrow="The team" heading="Who you will be speaking to">
    <ul class="grid gap-6 sm:grid-cols-3">
      {
        team.map((member) => (
          <li class="border-t border-rule pt-5">
            {/* Placeholder block: team photography was never supplied. */}
            <div
              class="mb-5 flex aspect-4/5 items-center justify-center rounded-[3px] border border-dashed border-rule bg-surface-2/4 text-[11px] tracking-[0.16em] text-muted uppercase"
              aria-hidden="true"
            >
              Photo to follow
            </div>
            <p class="eyebrow !text-muted">{member.role}</p>
            <p class="mt-3 font-display text-[20px] text-title">{member.name}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section heading="How we work">
    <ul class="grid gap-x-10 gap-y-9 lg:grid-cols-3">
      {
        principles.map((item) => (
          <li class="border-t border-rule pt-5">
            <h3 class="font-display text-[21px] leading-[1.3]">{item.title}</h3>
            <p class="mt-3 text-[14.5px] leading-[1.65] text-body">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    surface="tint"
    eyebrow="The alternatives, honestly"
    heading="There are three ways to charter an aircraft."
    standfirst="Each of them works for somebody. It is worth knowing which one you are using, and what it costs you when the plan changes."
  >
    {/*
      The Lapid card inverts to a dark surface rather than being tinted a
      shade lighter. On a light section that makes it the dominant element
      without needing a badge, a border colour or a "recommended" label —
      and because the colours are semantic, `on-dark` is the whole change.
    */}
    <ul class="grid gap-5 lg:grid-cols-3" data-reveal-group>
      {
        alternatives.map((item) => (
          <li
            class:list={[
              'rounded-[3px] border p-[clamp(22px,2.6vw,32px)]',
              item.highlight ? 'on-dark border-transparent bg-surface' : 'border-rule',
            ]}
          >
            <p class="eyebrow">{item.kicker}</p>
            <h3 class="mt-4 font-display text-[22px] leading-[1.25]">{item.title}</h3>
            <p class="mt-3 text-[14.5px] leading-[1.7] text-body">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section eyebrow="Beyond the aircraft" heading="What else sits with us.">
    <div class="max-w-measure">
      <p class="text-[16px] leading-[1.78] text-body">
        Charter is the entry point, but most trips need a car, somewhere to stay and a
        reason for going. We arrange those too, through destination partners rather
        than as services we provide ourselves.
      </p>
      <a href={PAGES.privateWorld.url} class="cta-ghost mt-9">Explore the Private World</a>
    </div>
  </Section>

  <CtaBand
    heading="Questions before your first enquiry?"
    cta={{ label: 'Speak With Lapid', href: PAGES.contact.url }}
  />
</Layout>
