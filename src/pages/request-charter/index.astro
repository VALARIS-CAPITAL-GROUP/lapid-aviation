---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import Section from '~/components/Section.astro';
import EnquiryForm from '~/components/EnquiryForm.astro';
import { NEXT_STEPS } from '~/data/content';
import { PAGES } from '~/data/site';

const meta = PAGES.request;
---

<Layout meta={meta}>
  <Breadcrumb trail={[{ name: 'Request charter', url: meta.url }]} />

  <section class="pt-[clamp(28px,3.5vw,44px)] pb-[clamp(52px,7vw,84px)]">
    <div class="shell">
      <div class="grid gap-[clamp(32px,5vw,64px)] lg:grid-cols-[1fr_1.1fr]">
        <div>
          <p class="eyebrow">Request a Charter</p>
          <h1 class="mt-5 text-display">Every detail handled before you leave.</h1>
          <p class="mt-6 max-w-measure text-[17px] leading-[1.62] text-ash">
            Four fields to start. A broker replies with the realistic options for your route and
            date, including the ones we would not recommend and why.
          </p>

          <h2 class="eyebrow mt-12">What happens next</h2>
          <ol class="mt-6 border-t border-hair">
            {
              NEXT_STEPS.map((step) => (
                <li class="grid grid-cols-[auto_1fr] gap-x-5 border-b border-hair py-5">
                  <span
                    class="font-display text-[14px] tabular-nums text-gold-light"
                    aria-hidden="true"
                  >
                    {step.n}
                  </span>
                  <div>
                    <h3 class="font-display text-[19px] leading-[1.3]">{step.name}</h3>
                    <p class="mt-1 text-[14px] leading-[1.6] text-ash">{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>

          <p class="mt-8 max-w-measure text-[12.5px] leading-[1.65] text-slate">
            Lapid Aviation arranges private jet and helicopter charter through appropriately
            licensed third-party aircraft operators. We do not own or operate aircraft. Aircraft
            availability is subject to operator availability, routing and dates.
          </p>
        </div>

        <div>
          <EnquiryForm />
        </div>
      </div>
    </div>
  </section>

  <Section
    surface="charcoal"
    heading="Would rather talk it through?"
    standfirst="For an urgent departure, calling is faster than the form."
  >
    <a
      href={PAGES.contact.url}
      class="text-[15px] text-gold-light transition-colors hover:text-paper"
    >
      Contact a broker &rarr;
    </a>
  </Section>
</Layout>
