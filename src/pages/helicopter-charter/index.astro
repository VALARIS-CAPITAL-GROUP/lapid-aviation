---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import PageHero from '~/components/PageHero.astro';
import Section from '~/components/Section.astro';
import Faq from '~/components/Faq.astro';
import CtaBand from '~/components/CtaBand.astro';
import ResearchNote from '~/components/ResearchNote.astro';
import { HELI_FAQS, HELI_USES } from '~/data/content';
import { PAGES } from '~/data/site';
import { faqSchema, serviceSchema } from '~/lib/schema';

const meta = PAGES.helicopter;

const sites = [
  {
    title: 'London Heliport, Battersea',
    body: "London's central licensed heliport and the usual starting point for city departures.",
  },
  {
    title: 'Airfields around the M25',
    body: 'Used for jet connections and for departures that suit a start outside the city.',
  },
  {
    title: 'Private and event sites',
    body: 'Arranged case by case, subject to landowner permission and operator assessment.',
  },
];

const schema = [
  serviceSchema({
    name: 'Helicopter charter in London',
    description: meta.desc,
    serviceType: 'Helicopter charter',
  }),
  faqSchema(HELI_FAQS),
];
---

<Layout meta={meta} schema={schema}>
  <Breadcrumb trail={[{ name: 'Helicopter charter', url: meta.url }]} />

  <PageHero
    eyebrow="Helicopter charter"
    heading="Helicopter charter in and around London"
    standfirst="A helicopter solves the part of the journey a jet cannot: the ground. Short sectors, private landing sites and connections onto a waiting aircraft, arranged through licensed operators."
    primary={{ label: 'Request a helicopter', href: PAGES.request.url }}
  />

  <Section surface="cream" heading="What a helicopter is for">
    <ul class="grid gap-x-10 gap-y-9 sm:grid-cols-2">
      {
        HELI_USES.map((use) => (
          <li class="border-t border-navy/15 pt-5">
            <h3 class="font-serif text-[21px] leading-[1.3]">{use.name}</h3>
            <p class="mt-3 text-[14.5px] leading-[1.65] text-muted">{use.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    heading="Departure and landing sites"
    standfirst="Helicopter movements around London are tightly governed. Every departure point, route and landing site is confirmed with the operator before we quote."
  >
    <ul class="grid gap-x-10 gap-y-9 lg:grid-cols-3">
      {
        sites.map((site) => (
          <li class="border-t border-line pt-5">
            <h3 class="font-serif text-[21px] leading-[1.3]">{site.title}</h3>
            <p class="mt-3 text-[14.5px] leading-[1.65] text-muted">{site.body}</p>
          </li>
        ))
      }
    </ul>
    <ResearchNote>
      Named heliports, permitted routings, sector times and helicopter types to be verified before
      publishing individual helicopter route pages.
    </ResearchNote>
  </Section>

  <Section surface="cream" heading="Common questions">
    <Faq items={HELI_FAQS} />
  </Section>

  <CtaBand
    heading="Tell us the route and the day."
    body="We will confirm what is permitted, and what it means for the timing."
  />
</Layout>
