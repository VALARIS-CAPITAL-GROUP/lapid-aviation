---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import PageHero from '~/components/PageHero.astro';
import Section from '~/components/Section.astro';
import DisclosureList from '~/components/DisclosureList.astro';
import CtaBand from '~/components/CtaBand.astro';
import { SECTORS } from '~/data/content';
import { PAGES } from '~/data/site';
import { serviceSchema } from '~/lib/schema';

const meta = PAGES.business;

const advantages = [
  {
    title: 'The day, not the flight',
    body: 'Departure times are set around the meeting, not the timetable. A morning in one city and an afternoon in another stops being a two-day trip.',
  },
  {
    title: 'Work in transit',
    body: 'A private cabin is a working room. Conversations that cannot happen in a lounge or an airline seat happen in the air instead.',
  },
  {
    title: 'Fewer moving parts',
    body: 'One point of contact for aircraft, airports and ground transfers across an itinerary, and one set of paperwork at the end of it.',
  },
];

const roadshows = [
  {
    title: 'Built backwards from the diary',
    body: 'We start with the meetings that cannot move and work outwards, rather than fitting the schedule to a convenient aircraft.',
  },
  {
    title: 'Honest about what will not fly',
    body: 'Crew duty limits, airport hours and slots put real boundaries on an itinerary. We tell you where a plan breaks before it is agreed with anyone else.',
  },
  {
    title: 'One aircraft or several',
    body: 'Holding one aircraft across a tour is sometimes the cheaper answer and sometimes not. We show the comparison rather than assuming.',
  },
];

const sectors = SECTORS.map((sector) => ({
  name: sector.name,
  line: sector.line,
  more: sector.more,
}));

const schema = [
  serviceSchema({
    name: 'Corporate private jet charter',
    description: meta.desc,
    serviceType: 'Business aviation charter',
  }),
];
---

<Layout meta={meta} schema={schema}>
  <Breadcrumb trail={[{ name: 'Business aviation', url: meta.url }]} />

  <PageHero
    eyebrow="Business aviation"
    heading="Three meetings. Three cities. One working day."
    standfirst="Corporate charter is a scheduling instrument. It puts the aircraft where your business needs to be, on the day it needs to be there, and gives you back the hours that connections and overnight stays take away."
    primary={{ label: 'Discuss business travel', href: PAGES.contact.url }}
  />

  <Section surface="cream" heading="Where the time comes back">
    <ul class="grid gap-x-10 gap-y-9 lg:grid-cols-3">
      {
        advantages.map((item) => (
          <li class="border-t border-navy/15 pt-5">
            <h3 class="font-serif text-[21px] leading-[1.3]">{item.title}</h3>
            <p class="mt-3 text-[14.5px] leading-[1.65] text-muted">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    eyebrow="Who we work with"
    heading="Different businesses, different reasons to fly"
  >
    <DisclosureList items={sectors} />
  </Section>

  <Section
    surface="cream"
    heading="Multi-city and roadshows"
    standfirst="Several cities in a fixed window is where charter earns its keep, and where planning matters most."
  >
    <ul class="grid gap-x-10 gap-y-9 lg:grid-cols-3">
      {
        roadshows.map((item) => (
          <li class="border-t border-navy/15 pt-5">
            <h3 class="font-serif text-[21px] leading-[1.3]">{item.title}</h3>
            <p class="mt-3 text-[14.5px] leading-[1.65] text-muted">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <CtaBand
    heading="Send us next quarter's travel and we will tell you what is worth flying privately."
    cta={{ label: 'Discuss business travel', href: PAGES.contact.url }}
  />
</Layout>
