---
import Layout from '~/layouts/Layout.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import { CONTACT, contactHref, PAGES, SITE } from '~/data/site';
import heroImage from '~/assets/jets-apron.jpg';

/**
 * Where the enquiry form lands after a successful post.
 *
 * `noindex` — it has no standalone value in search and should never be a
 * landing page. It is also the `action` of the form, so Netlify redirects
 * here on success.
 */
const meta = {
  title: `Enquiry received | ${SITE.name}`,
  url: '/enquiry-received/',
  desc: 'Your enquiry has reached a broker. We reply personally, usually within a couple of hours.',
  intent: 'n/a · confirmation',
};

const next = [
  {
    n: '01',
    name: 'A person reads it',
    body: 'Not a quote engine. The broker who picks it up is the one who will stay with the journey through to arrival.',
  },
  {
    n: '02',
    name: 'We come back with options',
    body: 'Usually within a couple of hours in working time, and same-day for an urgent departure. A shortlist with the trade-offs stated, not a single take-it-or-leave-it price.',
  },
  {
    n: '03',
    name: 'Nothing is committed',
    body: 'An enquiry is not a booking. Nothing is confirmed, and nothing is chargeable, until you say so in writing.',
  },
];
---

<Layout meta={meta} noindex>
  <Hero
    image={heroImage}
    alt="Private jets parked on the apron at dusk"
    eyebrow="Enquiry received"
    heading="Thank you. It has reached a broker."
    standfirst="We reply personally rather than automatically, so the next message you get will be from the person handling the journey."
    secondary={{ label: 'Back to the home page', href: '/' }}
  />

  <Section eyebrow="What happens now" heading="Three things, in order.">
    <ol class="grid gap-x-10 gap-y-9 lg:grid-cols-3" data-reveal-group>
      {
        next.map((step) => (
          <li class="border-t border-white/12 pt-6">
            <span class="font-display text-[13px] tabular-nums text-slate">{step.n}</span>
            <h3 class="mt-5 font-display text-[clamp(20px,1.8vw,24px)] leading-[1.25]">
              {step.name}
            </h3>
            <p class="mt-3 text-[14.5px] leading-[1.7] text-ash">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section surface="charcoal" eyebrow="If it is urgent" heading="Calling is faster than waiting.">
    <div class="max-w-measure">
      {
        CONTACT.phone ? (
          <p class="text-[16px] leading-[1.78] text-ash">
            For a departure inside 24 hours, speak to a broker directly on{' '}
            <a href={contactHref('phone')} class="cta-text">
              {CONTACT.phone}
            </a>
            .
          </p>
        ) : (
          <p class="text-[16px] leading-[1.78] text-ash">
            For a departure inside 24 hours, a call is faster than a written exchange.
            Our direct line is on the contact page.
          </p>
        )
      }
      <a href={PAGES.contact.url} class="cta-ghost mt-9">Speak With Lapid</a>
    </div>
  </Section>
</Layout>
