---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import CtaBand from '~/components/CtaBand.astro';
import ResearchNote from '~/components/ResearchNote.astro';
import { PAGES } from '~/data/site';
import heroImage from '~/assets/london-hero.jpg';

const meta = PAGES.mayfair;

const notes = [
  {
    title: 'Traveller profile',
    body: 'Family offices, private equity and finance professionals, alongside international residents travelling between London and other homes.',
  },
  {
    title: 'Suitable airports',
    body: 'Biggin Hill and Farnborough are both realistic starting points from Mayfair; the better choice depends on traffic and your destination on the day.',
    link: { label: 'See airports', href: PAGES.airportsHub.url },
  },
  {
    title: 'Helicopter option',
    body: 'London Heliport at Battersea is a short journey from Mayfair, useful for a helicopter connection onto a waiting jet.',
    link: { label: 'See helicopter charter', href: PAGES.helicopter.url },
  },
  {
    title: 'First time from Mayfair?',
    body: 'A car collects you directly and drops at a private terminal — no different in principle from any other departure point.',
    link: { label: 'What to expect', href: PAGES.firsttime.url },
  },
];
---

<Layout meta={meta} noindex>
  <Hero
    image={heroImage}
    alt="The London skyline seen from the west"
    eyebrow="Mayfair"
    heading="Private jet charter for Mayfair"
    standfirst="Mayfair's mix of family offices, private banks and members' clubs means most enquiries from the area are business trips or short-notice leisure travel, often booked with little lead time."
    primary={{ label: 'Request a charter', href: PAGES.request.url }}
  />

  <Breadcrumb
    trail={[
      { name: 'London', url: PAGES.londonHub.url },
      { name: 'Mayfair', url: meta.url },
    ]}
  />

  <Section surface="charcoal" heading="Flying from Mayfair">
    <ul class="grid gap-x-10 gap-y-9 sm:grid-cols-2">
      {
        notes.map((note) => (
          <li class="border-t border-white/12 pt-5">
            <h3 class="font-display text-[21px] leading-[1.3]">{note.title}</h3>
            <p class="mt-3 text-[14.5px] leading-[1.65] text-ash">{note.body}</p>
            {note.link && (
              <a
                href={note.link.href}
                class="mt-3 inline-block text-[13px] font-medium text-gold-light transition-colors hover:text-paper"
              >
                {note.link.label} &rarr;
              </a>
            )}
          </li>
        ))
      }
    </ul>
    <ResearchNote>
      Specific drive times from Mayfair to each airport to be verified before publishing figures.
    </ResearchNote>
  </Section>

  <CtaBand heading="Travelling from Mayfair?" />
</Layout>
