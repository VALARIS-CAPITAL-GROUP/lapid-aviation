---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import DisclosureList from '~/components/DisclosureList.astro';
import Faq from '~/components/Faq.astro';
import Ecosystem from '~/components/Ecosystem.astro';
import CtaBand from '~/components/CtaBand.astro';
import ResearchNote from '~/components/ResearchNote.astro';
import { AIRPORTS, CATEGORIES, JET_FAQS, ROUTE_DETAIL } from '~/data/content';
import { PAGES } from '~/data/site';
import { faqSchema, serviceSchema } from '~/lib/schema';
import heroImage from '~/assets/jets-hero.jpg';

const meta = PAGES.jets;

const categories = CATEGORIES.map((category) => ({
  name: category.name,
  line: category.use,
  more: category.more,
  tag: category.spec,
}));

const schema = [
  serviceSchema({
    name: 'Private jet charter from London',
    description: meta.desc,
    serviceType: 'Private jet charter',
  }),
  faqSchema(JET_FAQS),
];
---

<Layout meta={meta} schema={schema}>
  <Hero
    image={heroImage}
    alt="A row of private jets parked on an open apron"
    eyebrow="Private jet charter"
    heading="Private jet charter from London"
    standfirst="Charter is a flight arranged for you alone: your departure time, your passengers, your airport. We source the aircraft from licensed operators and manage the arrangement end to end, from the first enquiry to the arrival transfer."
    primary={{ label: 'Request a Charter', href: PAGES.request.url }}
    secondary={{ label: 'What it costs', href: PAGES.cost.url }}
  />

  <Breadcrumb trail={[{ name: 'Private jets', url: meta.url }]} />

  <Section
    surface="tint"
    heading="Which aircraft, and why it matters"
    standfirst="Category determines range, cabin size and luggage more than anything else. The right answer depends on the sector, the group and how much of the day you want back."
  >
    <DisclosureList items={categories} />
    <ResearchNote>
      Seat counts, range figures and typical baggage volumes to be populated from verified
      operator and manufacturer data before this page is indexed.
    </ResearchNote>
    <a
      href={PAGES.aircraft.url}
      class="mt-8 inline-block text-[13px] font-medium text-accent transition-colors hover:text-title"
    >
      Every category we can source &rarr;
    </a>
  </Section>

  <Section
    eyebrow="Departure airports"
    heading="The airport choice is part of the flight"
    standfirst="Where you leave from changes the ground journey, the handling and sometimes the aircraft available on the day. We weigh all three rather than defaulting to one field."
  >
    <ul class="grid gap-x-10 gap-y-7 sm:grid-cols-2 lg:grid-cols-3">
      {
        AIRPORTS.map((airport) => (
          <li class="border-t border-rule pt-5">
            <h3 class="font-display text-[20px]">{airport.name}</h3>
            <p class="mt-2 text-[14.5px] leading-[1.65] text-body">{airport.note}</p>
          </li>
        ))
      }
    </ul>
    <a
      href={PAGES.airportsHub.url}
      class="mt-10 inline-block text-[13px] font-medium text-accent transition-colors hover:text-title"
    >
      All airports &rarr;
    </a>
  </Section>

  <!--
    Routes were missing entirely from this page, which left the highest-intent
    pages on the site reachable only from the footer.
  -->
  <Section
    surface="tint"
    eyebrow="Where we fly"
    heading="The routes we are asked for most"
    standfirst="Each one with the distance measured rather than quoted, the block time as the range it really is, and the aircraft categories that suit it."
  >
    <ul class="flex flex-wrap gap-x-8 gap-y-4">
      {
        ROUTE_DETAIL.map((route) => (
          <li>
            <a href={`/routes/${route.slug}/`} class="cta-text">
              London to {route.city} &rarr;
            </a>
          </li>
        ))
      }
    </ul>
    <a href={PAGES.routesHub.url} class="cta-ghost mt-10">All routes from London</a>
  </Section>

  <Section heading="Common questions">
    <Faq items={JET_FAQS} />
  </Section>

  <!-- The ecosystem reveal: the flight is rarely the whole trip. -->
  <Section
    eyebrow="Beyond the flight"
    heading="The aircraft is the way in, not the whole journey."
    standfirst="Most trips need a car at both ends, somewhere worth staying and a reason for going. Those sit with the same person who arranged the aircraft."
  >
    <Ecosystem omit={meta.url} />
  </Section>

  <CtaBand
    heading="Tell us the route and the day."
    body="We will come back with the aircraft that fit, and the ones that do not."
  />
</Layout>
