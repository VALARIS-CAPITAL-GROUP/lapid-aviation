---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import PageHero from '~/components/PageHero.astro';
import Section from '~/components/Section.astro';
import Faq from '~/components/Faq.astro';
import CtaBand from '~/components/CtaBand.astro';
import ResearchNote from '~/components/ResearchNote.astro';
import { COST_FACTORS, COST_FAQS } from '~/data/content';
import { PAGES } from '~/data/site';
import { faqSchema } from '~/lib/schema';

const meta = PAGES.cost;

const included = [
  'Aircraft, crew and fuel for the agreed routing',
  'Standard airport and handling charges at each end',
  'Positioning of the aircraft to your departure airport',
  'In-flight catering at a standard level',
];

const excluded = [
  'Ground transport at either end',
  'Specific catering, wines or special requests',
  'De-icing, extended waiting time and overnight crew costs',
  'Changes made after the contract is signed',
];

// No `offers` or price in the schema: this page is explicit that there is no
// rate card, and publishing invented figures would be both wrong and a
// rich-result risk.
const schema = [faqSchema(COST_FAQS)];
---

<Layout meta={meta} schema={schema}>
  <Breadcrumb
    trail={[
      { name: 'Private jets', url: PAGES.jets.url },
      { name: 'Cost', url: meta.url },
    ]}
  />

  <PageHero
    eyebrow="Charter cost"
    heading="What private jet charter costs"
    standfirst="Charter is priced per flight, not per seat, and quoted for your specific routing and dates. There is no fixed rate card: the same city pair can differ substantially depending on the aircraft, the timing and where that aircraft has to come from."
    primary={{ label: 'Request a quote', href: PAGES.request.url }}
  />

  <Section
    surface="cream"
    eyebrow="What moves the number"
    heading="Six factors, in roughly this order"
  >
    <ol class="grid gap-x-12 gap-y-9 sm:grid-cols-2">
      {
        COST_FACTORS.map((factor) => (
          <li class="border-t border-navy/15 pt-5">
            <p class="text-[13px] tabular-nums text-copper">{factor.n}</p>
            <h3 class="mt-2 font-serif text-[21px] leading-[1.3]">{factor.name}</h3>
            <p class="mt-2 text-[14.5px] leading-[1.65] text-muted">{factor.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section heading="What the quote covers">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <h3 class="eyebrow">Usually inside the quote</h3>
        <ul class="mt-5 space-y-3">
          {
            included.map((item) => (
              <li class="flex gap-3 border-b border-line pb-3 text-[14.5px] leading-[1.6]">
                <span class="text-copper" aria-hidden="true">
                  &#43;
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="eyebrow !text-faint">Often outside it</h3>
        <ul class="mt-5 space-y-3">
          {
            excluded.map((item) => (
              <li class="flex gap-3 border-b border-line pb-3 text-[14.5px] leading-[1.6]">
                <span class="text-faint" aria-hidden="true">
                  &minus;
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <ResearchNote>
      Indicative price ranges: a table by aircraft category and sector length belongs here and
      will convert well. It stays unpublished until the figures come from real quotes or verified
      market data.
    </ResearchNote>
  </Section>

  <Section surface="cream" heading="Common questions">
    <Faq items={COST_FAQS} />
  </Section>

  <CtaBand heading="A quote takes a route, a date and a passenger count." />
</Layout>
