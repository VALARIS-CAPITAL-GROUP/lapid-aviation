---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import Faq from '~/components/Faq.astro';
import CtaBand from '~/components/CtaBand.astro';
import RateTable from '~/components/RateTable.astro';
import { COST_FACTORS, COST_FAQS, RATE_CAVEATS } from '~/data/content';
import { PAGES } from '~/data/site';
import { faqSchema } from '~/lib/schema';
import heroImage from '~/assets/hangar.jpg';

const meta = PAGES.cost;

const included = [
  'Aircraft, crew and fuel for the agreed routing',
  'Standard airport and handling charges at each end',
  'Positioning of the aircraft to your departure airport',
  'In-flight catering at a standard level',
];

const excluded = [
  'Ground transport at either end',
  'Specific catering, wines or special requests',
  'De-icing, extended waiting time and overnight crew costs',
  'Changes made after the contract is signed',
];

// No `offers` or price in the schema: this page is explicit that there is no
// rate card, and publishing invented figures would be both wrong and a
// rich-result risk.
const schema = [faqSchema(COST_FAQS)];
---

<Layout meta={meta} schema={schema}>
  <Hero
    image={heroImage}
    alt="Private jets inside a maintenance hangar"
    eyebrow="Charter cost"
    heading="What private jet charter costs"
    standfirst="Charter is priced per flight, not per seat, and quoted for your specific routing and dates. There is no fixed rate card: the same city pair can differ substantially depending on the aircraft, the timing and where that aircraft has to come from."
    primary={{ label: 'Request a quote', href: PAGES.request.url }}
  />

  <Breadcrumb
    trail={[
      { name: 'Private jets', url: PAGES.jets.url },
      { name: 'Cost', url: meta.url },
    ]}
  />

  <Section
    surface="tint"
    eyebrow="What moves the number"
    heading="Six factors, in roughly this order"
  >
    <ol class="grid gap-x-12 gap-y-9 sm:grid-cols-2">
      {
        COST_FACTORS.map((factor) => (
          <li class="border-t border-rule pt-5">
            <p class="text-[13px] tabular-nums text-accent">{factor.n}</p>
            <h3 class="mt-2 font-display text-[21px] leading-[1.3]">{factor.name}</h3>
            <p class="mt-2 text-[14.5px] leading-[1.65] text-body">{factor.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section heading="What the quote covers">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <h3 class="eyebrow">Usually inside the quote</h3>
        <ul class="mt-5 space-y-3">
          {
            included.map((item) => (
              <li class="flex gap-3 border-b border-rule pb-3 text-[14.5px] leading-[1.6]">
                <span class="text-accent" aria-hidden="true">
                  &#43;
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="eyebrow !text-muted">Often outside it</h3>
        <ul class="mt-5 space-y-3">
          {
            excluded.map((item) => (
              <li class="flex gap-3 border-b border-rule pb-3 text-[14.5px] leading-[1.6]">
                <span class="text-muted" aria-hidden="true">
                  &minus;
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!--
    The competitor review that prompted this block found the London market
    split in two: sites that publish nothing on price at all, and sites that
    publish one precise-looking total per route as though a route had a price.
    The first is unhelpful and the second is untrue. Ranges with their
    provenance stated are the only version of this that survives scrutiny.
  -->
  <Section
    surface="tint"
    eyebrow="Order of magnitude"
    heading="What an hour in the air costs"
    standfirst="We will not invent a price for your flight before we have quoted it. We will tell you what the market charges per flying hour, so you can decide whether to have the conversation at all."
  >
    <RateTable />

    <h3 class="eyebrow mt-14">And what sits on top of it</h3>
    <p class="mt-4 max-w-measure text-[15px] leading-[1.7] text-body">
      An hourly rate multiplied by a flight time is the floor, not the answer. Four things move
      the total above it, and on a short sector they can exceed the flying cost itself.
    </p>
    <ul class="mt-8 grid gap-x-10 gap-y-7 sm:grid-cols-2">
      {
        RATE_CAVEATS.map((caveat) => (
          <li class="border-t border-rule pt-4">
            <h4 class="font-display text-[18px] leading-[1.3]">{caveat.name}</h4>
            <p class="mt-2 text-[14.5px] leading-[1.65] text-body">{caveat.body}</p>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 max-w-measure text-[15px] leading-[1.7] text-body">
      Very light jets and turboprops are not in the table. The published figures for them
      disagree too widely to quote honestly, and on the short sectors they suit, positioning
      dominates the price to the point where an hourly rate tells you almost nothing.
    </p>

    <a href={PAGES.routesHub.url} class="cta-text mt-10">
      See the block times these multiply against &rarr;
    </a>
  </Section>

  <Section surface="tint" heading="Common questions">
    <Faq items={COST_FAQS} />
  </Section>

  <CtaBand heading="A quote takes a route, a date and a passenger count." />
</Layout>
