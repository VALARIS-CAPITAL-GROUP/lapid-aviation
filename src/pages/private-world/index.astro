---
import Layout from '~/layouts/Layout.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import Split from '~/components/Split.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import Ecosystem from '~/components/Ecosystem.astro';
import JourneyArc from '~/components/JourneyArc.astro';
import Collections from '~/components/Collections.astro';
import CtaBand from '~/components/CtaBand.astro';
import { JOURNEY_ARC, SAMPLE_JOURNEYS, PILLARS } from '~/data/content';
import { PAGES } from '~/data/site';
import hangar from '~/assets/hangar.jpg';
import resortsHero from '~/assets/resorts-hero.jpg';
import transfersHero from '~/assets/transfers-hero.jpg';

const meta = PAGES.privateWorld;

/**
 * The ecosystem hub: the page that makes the case that the seven services are
 * one journey rather than seven products.
 *
 * Linked from the primary nav as "Private World", so it carries the weight of
 * explaining the wider offering that the home page only gestures at.
 */
---

<Layout meta={meta}>
  <Hero
    image={hangar}
    alt="Private jets inside a lit hangar"
    eyebrow="The private world of Lapid"
    heading="One relationship. The whole journey."
    standfirst="Aviation is the way in. Beyond it sits the ground, the stay and the reason for the trip — held by the same people, so nothing is handed over halfway."
    primary={{ label: 'Plan Your Journey', href: PAGES.request.url }}
    secondary={{ label: 'Speak With Lapid', href: PAGES.contact.url }}
  />

  <Breadcrumb trail={[{ name: 'Private World', url: meta.url }]} />

  <Section
    eyebrow="What this is"
    heading="A private lifestyle infrastructure, not a booking site."
    standfirst="Most luxury travel is assembled from separate suppliers who never speak to each other. The aircraft is booked by one company, the car by another, the house by a third — and the gaps between them are where the time you paid for disappears."
  >
    <div class="grid gap-10 lg:grid-cols-2">
      <p class="text-[16px] leading-[1.78] text-body">
        Lapid holds the whole line instead. The person who chose your departure airport
        is the person who briefs your driver, tells the property when you actually land,
        and moves all three when the meeting overruns.
      </p>
      <p class="text-[16px] leading-[1.78] text-body">
        That is the entire proposition. Not a wider catalogue, but a single point of
        contact with enough of the journey in their hands to be useful when something
        changes.
      </p>
    </div>
  </Section>

  <!-- The arc, restated for people who arrive here directly. -->
  <Section
    surface="tint"
    eyebrow="The shape of it"
    heading="From your door to the reason you travelled."
  >
    <JourneyArc steps={JOURNEY_ARC} />
  </Section>

  <Section
    eyebrow="Seven parts"
    heading="Everything we arrange."
    standfirst="Aviation first, because it is what most people come to us for and it sets the shape of the day. The rest exists because the flight is rarely the point of the trip."
  >
    <Ecosystem />
  </Section>

  <Split
    image={transfersHero}
    alt="A chauffeur holding open the door of an executive car"
    eyebrow="Why it matters on the ground"
    heading="The last hour is where journeys fail."
    surface="tint"
    flip
  >
    <p>
      A jet saves three hours and a badly planned transfer gives two of them back. The
      road from Geneva into the Alps, the August coast road out of Nice, the run from a
      London field into the City at five o'clock — these are the parts that decide
      whether the aircraft was worth it.
    </p>
    <p>
      So we plan them first, and brief them against the tail number rather than a
      nominal pickup time.
    </p>
    <a href={PAGES.transfers.url} class="cta-text">Chauffeur &amp; ground transport &rarr;</a>
  </Split>

  <Section
    eyebrow="Curated collections"
    heading="Where would you like to wake up?"
    standfirst="Organised the way people actually think about a trip — by the kind of place they want to be in, rather than by star rating or nightly rate."
  >
    <Collections />
    <div class="mt-12 flex flex-wrap gap-x-8 gap-y-4" data-reveal>
      <a href={PAGES.hotels.url} class="cta-ghost">Discover the Collection</a>
      <a href={PAGES.resorts.url} class="cta-text mt-4">Bespoke resorts &amp; villas &rarr;</a>
    </div>
  </Section>

  <Split
    image={resortsHero}
    alt="An infinity pool and terrace looking out over a lake and mountains"
    eyebrow="The reason for the trip"
    heading="The journey is not the point."
    surface="light"
  >
    <p>
      Nobody remembers the aircraft. They remember the table on the terrace, the
      mountain before the lifts turned, the week the family was in one house rather
      than four hotel rooms.
    </p>
    <p>
      Which is why we arrange that end of it too — and why we will tell you plainly
      when something cannot be arranged rather than promising it and working it out
      later.
    </p>
    <a href={PAGES.experiences.url} class="cta-text">Private experiences &rarr;</a>
  </Split>

  <Section
    surface="tint"
    eyebrow="Journeys"
    heading="What it looks like when the pieces connect."
  >
    <ul class="grid gap-px overflow-hidden bg-rule lg:grid-cols-3" data-reveal-group>
      {
        SAMPLE_JOURNEYS.map((journey) => (
          <li class="flex flex-col bg-surface p-[clamp(24px,2.8vw,36px)]">
            <p class="eyebrow !text-muted">{journey.kicker}</p>
            <h3 class="mt-5 font-display text-[clamp(21px,1.9vw,26px)] leading-[1.2]">
              {journey.title}
            </h3>
            <ol class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-2">
              {journey.steps.map((step, i) => (
                <li class="flex items-center gap-2">
                  <span class="text-[12px] tracking-[0.04em] text-title">{step}</span>
                  {i < journey.steps.length - 1 && (
                    <span aria-hidden="true" class="text-[11px] text-accent/70">
                      &rarr;
                    </span>
                  )}
                </li>
              ))}
            </ol>
            <p class="mt-6 flex-1 text-[14.5px] leading-[1.7] text-body">{journey.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section eyebrow="What you are buying" heading="Four things, underneath all of it.">
    <dl class="grid gap-x-10 gap-y-9 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {
        PILLARS.map((pillar) => (
          <div class="border-t border-rule pt-6">
            <dt class="font-display text-[22px] leading-[1.2] text-title">{pillar.name}</dt>
            <dd class="mt-3 text-[14.5px] leading-[1.7] text-body">{pillar.body}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <!--
    Customer-facing, so this is ordinary copy rather than a <ResearchNote> —
    that component is a dev-only internal flag and never reaches production.
  -->
  <Section>
    <div class="max-w-measure border-l border-accent/40 pl-7" data-reveal>
      <p class="eyebrow">What we are, plainly</p>
      <p class="mt-5 text-[14.5px] leading-[1.75] text-body">
        Lapid Aviation is a charter broker. We own and operate no aircraft, and the
        wider services on this page — ground transport, vehicle hire, hotels, resorts
        and experiences — are arranged through third-party partners and suppliers
        rather than provided by us.
      </p>
      <p class="mt-4 text-[14.5px] leading-[1.75] text-body">
        Availability depends on the destination, the season and the supplier. We
        confirm what is genuinely possible for your dates before you commit to
        anything, and we would rather decline a request than promise it and work it
        out afterwards.
      </p>
    </div>
  </Section>

  <CtaBand
    image={resortsHero}
    alt=""
    heading="Where would you like to be?"
    body="Start with a destination, a date, or just an idea. We will tell you what is possible."
    cta={{ label: 'Plan Your Journey', href: PAGES.request.url }}
  />
</Layout>
