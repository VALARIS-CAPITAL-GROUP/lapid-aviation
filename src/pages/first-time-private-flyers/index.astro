---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import CtaBand from '~/components/CtaBand.astro';
import ResearchNote from '~/components/ResearchNote.astro';
import { BEFORE_DAY, ON_DAY } from '~/data/content';
import { PAGES } from '~/data/site';
import heroImage from '~/assets/cabin-work.jpg';

const meta = PAGES.firsttime;

const questions = [
  'Who is operating the flight, and under which licence?',
  'What is included in this price, and what is not?',
  'What happens if the aircraft goes technical on the morning of the flight?',
  'What are the cancellation terms, and when do they start to apply?',
];
---

<Layout meta={meta}>
  <Hero
    image={heroImage}
    alt="A passenger working at a table in a private jet cabin"
    eyebrow="First-time flyers"
    heading="Your first private flight, made simple"
    standfirst="Most of what people expect from flying does not apply. There is no check-in hall, no gate, and very little waiting. This is what actually happens, from enquiry to arrival."
    primary={{ label: 'Speak to a broker', href: PAGES.contact.url }}
  />

  <Breadcrumb trail={[{ name: 'First time flying private', url: meta.url }]} />

  <Section
    surface="tint"
    heading="Before the day"
    standfirst="Everything that would normally happen at an airport happens in advance instead."
  >
    <ul class="grid gap-x-10 gap-y-9 sm:grid-cols-2">
      {
        BEFORE_DAY.map((item) => (
          <li class="border-t border-rule pt-5">
            <h3 class="font-display text-[21px] leading-[1.3]">{item.name}</h3>
            <p class="mt-3 text-[14.5px] leading-[1.65] text-body">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section heading="On the day">
    <ol class="border-t border-rule">
      {
        ON_DAY.map((item) => (
          <li class="grid grid-cols-[auto_1fr] gap-x-6 border-b border-rule py-6">
            <span class="font-display text-[15px] tabular-nums text-accent" aria-hidden="true">
              {item.n}
            </span>
            <div>
              <h3 class="font-display text-[21px] leading-[1.3]">{item.name}</h3>
              <p class="mt-2 max-w-measure text-[14.5px] leading-[1.65] text-body">
                {item.body}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
    <ResearchNote>
      Recommended arrival times before departure vary by airport and by domestic or international
      routing. To be confirmed per terminal before publishing a figure.
    </ResearchNote>
  </Section>

  <Section
    surface="tint"
    heading="What to ask your broker"
    standfirst="Four questions worth asking anyone quoting you a charter, including us."
  >
    <ol class="border-t border-rule">
      {
        questions.map((question, i) => (
          <li class="flex items-start gap-5 border-b border-rule py-5">
            <span class="mt-1 text-[13px] tabular-nums text-accent" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="font-display text-[19px] leading-[1.4] text-title">{question}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <CtaBand
    heading="Tell us the route and the day."
    body="No commitment. We reply with options, not a hard sell."
  />
</Layout>
