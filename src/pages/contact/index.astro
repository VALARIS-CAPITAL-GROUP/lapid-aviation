---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import Hero from '~/components/Hero.astro';
import CtaBand from '~/components/CtaBand.astro';
import ResearchNote from '~/components/ResearchNote.astro';
import { PAGES, CONTACT, contactHref, hasContactDetails } from '~/data/site';
import heroImage from '~/assets/london-hero.jpg';

const meta = PAGES.contact;

// Driven by CONTACT in site.ts, which is the one place these are defined. Any
// method still unset renders "to be confirmed" rather than an invented number.
const channels = [
  {
    label: 'Phone',
    value: CONTACT.phone ?? 'Number to be confirmed',
    href: CONTACT.phone ? contactHref('phone') : null,
  },
  {
    label: 'WhatsApp',
    value: CONTACT.whatsapp ?? 'Number to be confirmed',
    href: CONTACT.whatsapp ? contactHref('whatsapp') : null,
  },
  {
    label: 'Email',
    value: CONTACT.email ?? 'Address to be confirmed',
    href: CONTACT.email ? contactHref('email') : null,
  },
];
---

<Layout meta={meta}>
  <Hero
    image={heroImage}
    alt="The London skyline and the River Thames"
    eyebrow="Contact"
    heading="Speak to a broker"
    standfirst="Call, message or send a written enquiry. For an urgent departure, calling is faster than the form."
  />

  <Breadcrumb trail={[{ name: 'Contact', url: meta.url }]} />

  <section class="pb-[clamp(52px,7vw,84px)]">
    <div class="shell">
      <ul class="grid gap-6 sm:grid-cols-3">
        {
          channels.map((channel) => (
            <li class="rounded-[3px] border border-white/10 p-7">
              <p class="eyebrow">{channel.label}</p>
              {channel.href ? (
                <a
                  href={channel.href}
                  class="mt-4 block font-display text-[21px] text-gold-light transition-colors hover:text-paper"
                >
                  {channel.value}
                </a>
              ) : (
                <p class="mt-4 font-display text-[21px] text-slate">{channel.value}</p>
              )}
            </li>
          ))
        }
      </ul>
      {
        /* Dev-only reminder, and only while something is actually missing.
           Set CONTACT in src/data/site.ts — this page, the header strip and
           the schema all read from there. */
        !hasContactDetails && (
          <ResearchNote>
            One or more contact methods is still unset. Fill in <code>CONTACT</code> in
            <code>src/data/site.ts</code> and this page, the header contact strip and the
            click-to-call links all populate at once. Nothing else needs editing.
          </ResearchNote>
        )
      }
    </div>
  </section>

  <CtaBand heading="Or start with the route and the day." />
</Layout>
