---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Image-and-text half split. The main rhythm device: breaks up runs of text
 * sections without needing a full-bleed image every time.
 *
 * `flip` puts the image on the right. The image carries a scroll-driven
 * parallax so it drifts against the text column as the section passes.
 */
interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  heading: string;
  flip?: boolean;
  surface?: 'obsidian' | 'charcoal' | 'bone';
  position?: string;
}

const surfaces = {
  obsidian: 'bg-obsidian',
  charcoal: 'bg-charcoal',
  bone: 'bg-bone',
} as const;

const {
  image,
  alt,
  eyebrow,
  heading,
  flip = false,
  surface = 'charcoal',
  position = 'center',
}: Props = Astro.props;

const light = surface === 'bone';
---

{/* `on-light` flips the shared CTA styles to their dark-on-light variants. */}
<section class:list={[surfaces[surface], light && 'on-light', 'overflow-hidden']}>
  <div class="grid items-stretch lg:grid-cols-2">
    <div
      data-reveal
      style="--reveal-y:0px"
      class:list={[
        'relative min-h-[340px] overflow-hidden lg:min-h-[clamp(480px,50vw,700px)]',
        flip && 'lg:order-2',
      ]}
    >
      <!-- Scaled past the frame so the parallax drift never exposes an edge. -->
      <Image
        src={image}
        alt={alt}
        widths={[640, 1024, 1400]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        format="webp"
        loading="lazy"
        data-zoom
        data-parallax
        class="absolute inset-0 size-full scale-115 object-cover"
        style={`object-position:${position}`}
      />
    </div>

    <div
      class:list={[
        'flex items-center px-[clamp(24px,5vw,88px)] py-[clamp(56px,7vw,112px)]',
        flip && 'lg:order-1',
      ]}
    >
      <div class="max-w-[52ch]" data-reveal style="--reveal-delay:140ms">
        {
          eyebrow && (
            <>
              <p class:list={['eyebrow', light && '!text-gold']}>{eyebrow}</p>
              <span class="gold-rule mt-5" aria-hidden="true" />
            </>
          )
        }
        <h2 class:list={['mt-7 text-heading', light && '!text-ink']}>{heading}</h2>
        <div
          class:list={[
            'mt-7 space-y-6 text-[16px] leading-[1.78]',
            light ? 'text-ink-soft' : 'text-ash',
          ]}
        >
          <slot />
        </div>
      </div>
    </div>
  </div>
</section>
