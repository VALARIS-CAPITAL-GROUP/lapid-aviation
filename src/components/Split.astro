---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Image-and-text half split. The main rhythm device: breaks up runs of text
 * sections without needing a full-bleed image every time.
 *
 * `flip` puts the image on the right. The image carries a scroll-driven
 * parallax so it drifts against the text column as the section passes.
 */
interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  heading: string;
  flip?: boolean;
  /** `light` bone, `tint` the deeper bone, `dark` for a cinematic break. */
  surface?: 'light' | 'tint' | 'dark';
  position?: string;
}

const surfaces = {
  light: 'bg-surface',
  tint: 'bg-surface-2',
  dark: 'on-dark bg-surface',
} as const;

const {
  image,
  alt,
  eyebrow,
  heading,
  flip = false,
  surface = 'tint',
  position = 'center',
}: Props = Astro.props;

---

<section class:list={[surfaces[surface], 'overflow-hidden']}>
  <div class="grid items-stretch lg:grid-cols-2">
    <div
      data-reveal
      style="--reveal-y:0px"
      class:list={[
        'relative min-h-[340px] overflow-hidden lg:min-h-[clamp(480px,50vw,700px)]',
        flip && 'lg:order-2',
      ]}
    >
      <!-- Scaled past the frame so the parallax drift never exposes an edge. -->
      <Image
        src={image}
        alt={alt}
        widths={[640, 1024, 1400]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        format="webp"
        loading="lazy"
        data-zoom
        data-parallax
        class="absolute inset-0 size-full scale-115 object-cover"
        style={`object-position:${position}`}
      />
    </div>

    <div
      class:list={[
        'flex items-center px-[clamp(24px,5vw,88px)] py-[clamp(56px,7vw,112px)]',
        flip && 'lg:order-1',
      ]}
    >
      <div class="max-w-[52ch]" data-reveal style="--reveal-delay:140ms">
        {
          eyebrow && (
            <>
              <p class="eyebrow">{eyebrow}</p>
              <span class="gold-rule mt-5" aria-hidden="true" />
            </>
          )
        }
        <h2 class="mt-7 text-heading">{heading}</h2>
        <div class="mt-7 space-y-6 text-[16px] leading-[1.78] text-body">
          <slot />
        </div>
      </div>
    </div>
  </div>
</section>
