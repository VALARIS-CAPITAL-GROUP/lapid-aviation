---
import { PILLARS } from '~/data/content';

/**
 * The four brand pillars: time, freedom, access, effortless luxury.
 *
 * Deliberately typographic rather than iconographic. A row of four icons is
 * the house style of every SaaS landing page, and the brief rules out both
 * that and excessive icons — so the hierarchy here is carried by a numeral,
 * a hairline and the display face.
 *
 * Took a `light` prop before the semantic tokens existed; colours now resolve
 * against whichever surface it is placed on, so there is nothing to pass.
 */
---

<ol
  class="grid gap-x-10 gap-y-[clamp(40px,5vw,64px)] sm:grid-cols-2 lg:grid-cols-4"
  data-reveal-group
>
  {
    PILLARS.map((pillar, i) => (
      <li class="border-t border-rule pt-7">
        <span class="font-display text-[13px] tabular-nums text-muted">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class="mt-5 font-display text-[clamp(24px,2.3vw,30px)] leading-[1.15]">
          {pillar.name}
        </h3>
        <p class="mt-3 text-[14px] text-accent italic">{pillar.line}</p>
        <p class="mt-4 text-[14.5px] leading-[1.7] text-body">{pillar.body}</p>
      </li>
    ))
  }
</ol>
