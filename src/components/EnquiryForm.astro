---
/**
 * The full charter enquiry form.
 *
 * Two modes, so the form is never a dead end:
 *
 * 1. Netlify Forms (the default). The site already deploys on Netlify, so
 *    this needs no third-party account and no API key — Netlify's build step
 *    detects `data-netlify="true"` in the deployed HTML and captures
 *    submissions itself. Requires Forms to be enabled once in the Netlify
 *    dashboard for the site.
 * 2. `PUBLIC_ENQUIRY_ENDPOINT`, which overrides mode 1 if we later move to
 *    Formspark, Formspree, Basin or similar.
 *
 * Either way it is a plain HTML POST, so it works with JavaScript disabled.
 * If we ever adopt a server adapter, this becomes an Astro action.
 *
 * Pre-fills from the query string so the four-field opener on the home page
 * carries straight through. That has to happen client-side: this is a static
 * build, so `Astro.url.searchParams` is empty at render time. The inline
 * script at the bottom is the whole of it — without JS the form simply starts
 * empty, which is a fine fallback.
 */

import { RESPONSE_TIME } from '~/data/site';

interface Props {
  /** Submit label. The concierge pages ask for a journey, not just a charter. */
  submitLabel?: string;
}

const { submitLabel = 'Request a Charter' }: Props = Astro.props;

// A stated response time is the strongest thing this form can say, so it goes
// first when we have one. Until RESPONSE_TIME is set we promise nothing.
const hint = RESPONSE_TIME
  ? `A broker replies ${RESPONSE_TIME}. No commitment, and options rather than a hard sell.`
  : 'No commitment. We reply with options, not a hard sell.';

/**
 * An explicit endpoint wins; otherwise fall back to Netlify Forms, which
 * posts to the form's own page and is captured at the edge.
 */
const endpoint = import.meta.env.PUBLIC_ENQUIRY_ENDPOINT as string | undefined;
const useNetlify = !endpoint;
const FORM_NAME = 'charter-enquiry';

const fieldClass =
  'min-h-11 w-full border-0 border-b border-rule bg-transparent py-[9px] text-[16px] text-title outline-none focus:border-accent';
const labelClass = 'text-[10px] font-semibold tracking-[0.2em] text-body uppercase';
---

{/*
  `data-astro-reload` opts this form out of client-side routing. ClientRouter
  intercepts form submissions and swaps the response in, which would stop the
  POST from ever reaching Netlify's form handler.
*/}
<form
  method="POST"
  name={FORM_NAME}
  action={endpoint ?? '/enquiry-received/'}
  data-netlify={useNetlify ? 'true' : undefined}
  data-netlify-honeypot={useNetlify ? 'bot-field' : undefined}
  data-astro-reload
  class="rounded-[3px] border border-rule bg-surface-2 p-[clamp(20px,3vw,34px)]"
>
  {
    useNetlify && (
      <>
        {/* Netlify injects this itself for static HTML, but sending it
            explicitly makes the POST work identically either way. */}
        <input type="hidden" name="form-name" value={FORM_NAME} />
        {/* Honeypot: named in data-netlify-honeypot above. Hidden from sight
            and from the accessibility tree; a bot filling it is discarded. */}
        <p class="hidden" aria-hidden="true">
          <label>
            Leave this field empty
            <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>
      </>
    )
  }
  <h2 class="font-display text-[26px] text-title">Where would you like to be?</h2>
  <p class="mt-2 text-[13.5px] text-body">
    The four fields we need to start. Everything around the flight can come later.
  </p>

  <fieldset class="mt-7 mb-6 flex gap-[6px]">
    <legend class="sr-only">Trip type</legend>
    {
      [
        { value: 'return', label: 'Return', checked: true },
        { value: 'oneway', label: 'One-way', checked: false },
      ].map((option) => (
        <div>
          <input
            type="radio"
            name="trip"
            id={`req-trip-${option.value}`}
            value={option.value}
            checked={option.checked}
            class="peer sr-only"
          />
          {/*
            Checked state was `bg-surface-2` on a `bg-surface-2` form, so the
            selected pill was invisible. Graphite is the next surface up.
          */}
          <label
            for={`req-trip-${option.value}`}
            class="block cursor-pointer rounded-[20px] border border-transparent px-[14px] py-[6px] text-[11.5px] font-semibold text-body transition-colors peer-checked:border-accent/40 peer-checked:bg-surface-2 peer-checked:text-title peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-gold peer-focus-visible:outline-offset-2"
          >
            {option.label}
          </label>
        </div>
      ))
    }
  </fieldset>

  <div class="grid gap-6 sm:grid-cols-2">
    <div class="flex flex-col gap-2">
      <label class={labelClass} for="req-from">From</label>
      <input
        id="req-from"
        name="from"
        placeholder="London"
        required
        class={fieldClass}
      />
    </div>
    <div class="flex flex-col gap-2">
      <label class={labelClass} for="req-to">To</label>
      {/*
        Not required. Enquiries arriving from a collection tile ("Private
        Islands", "Alpine Retreats") have a region in mind rather than an
        airport, and a required field here made those a dead end.
      */}
      <input
        id="req-to"
        name="to"
        placeholder="Geneva, or a region"
        class={fieldClass}
      />
    </div>
    <div class="flex flex-col gap-2">
      <label class={labelClass} for="req-date">Date</label>
      <input id="req-date" name="date" type="date" class={fieldClass} />
    </div>
    <div class="flex flex-col gap-2">
      <label class={labelClass} for="req-pax">Passengers</label>
      <input
        id="req-pax"
        name="pax"
        type="number"
        min="1"
        max="19"
        inputmode="numeric"
        placeholder="4"
        class={fieldClass}
      />
    </div>
    <div class="flex flex-col gap-2">
      <label class={labelClass} for="req-name">Name</label>
      <input
        id="req-name"
        name="name"
        autocomplete="name"
        placeholder="Your name"
        required
        class={fieldClass}
      />
    </div>
    <div class="flex flex-col gap-2">
      <label class={labelClass} for="req-contact">Email or phone</label>
      <input
        id="req-contact"
        name="contact"
        autocomplete="email"
        placeholder="How to reach you"
        required
        class={fieldClass}
      />
    </div>
  </div>

  {/* `id` so the prefill script can open this when a link arrives carrying a
      collection or an interest, which would otherwise land in a closed panel
      and look as though the link had been ignored. */}
  <details class="group mt-7" id="req-more">
    <summary
      class="inline-flex cursor-pointer list-none items-center gap-2 text-[13px] font-medium text-accent [&::-webkit-details-marker]:hidden"
    >
      <span class="group-open:hidden">Add onward legs, a stay, anything unusual</span>
      <span class="hidden group-open:inline">Hide extra detail</span>
      <span class="transition-transform group-open:rotate-45" aria-hidden="true">&#43;</span>
    </summary>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      <div class="flex flex-col gap-2">
        <label class={labelClass} for="req-legs">Return or onward legs</label>
        <input
          id="req-legs"
          name="legs"
          placeholder="Same-day return, or add a city"
          class={fieldClass}
        />
      </div>
      <div class="flex flex-col gap-2">
        <label class={labelClass} for="req-interest">Anything beyond the flight</label>
        <input
          id="req-interest"
          name="interest"
          placeholder="A villa, a car, a table, a guide"
          class={fieldClass}
        />
      </div>
      <div class="flex flex-col gap-2 sm:col-span-2">
        <label class={labelClass} for="req-notes">Luggage, pets, anything unusual</label>
        <input
          id="req-notes"
          name="notes"
          placeholder="Skis, a dog, an early meeting"
          class={fieldClass}
        />
      </div>
    </div>
  </details>

  <button type="submit" class="cta mt-9 w-full cursor-pointer sm:w-auto">
    {submitLabel}
  </button>

  <p id="enquiry-hint" class="mt-5 text-[12.5px] leading-[1.6] text-body">{hint}</p>

  {
    /* Dev-only reminder of the one manual step Netlify Forms needs. Not shown
       in production: the form does work there, provided Forms is enabled for
       the site, and warning live visitors that it might not would cost more
       enquiries than it saves. */
    useNetlify && import.meta.env.DEV && (
      <p class="mt-4 rounded-[3px] border border-dashed border-accent/50 bg-accent/5 p-4 text-[12.5px] leading-[1.6] text-body">
        <strong>Netlify Forms mode.</strong> Submissions are captured by Netlify on the
        deployed site, which requires Forms to be enabled once for this site in the
        Netlify dashboard. Posting from localhost will not work — test on a deploy
        preview. To use a different provider instead, set
        <code>PUBLIC_ENQUIRY_ENDPOINT</code> (see <code>.env.example</code>).
      </p>
    )
  }
</form>

<script>
  // Carry the home page's four-field opener through to this form. Static
  // build, so this has to read the query string in the browser.
  const params = new URLSearchParams(location.search);
  const setField = (id: string, key: string) => {
    const value = params.get(key);
    const el = document.getElementById(id);
    if (value && el instanceof HTMLInputElement) el.value = value;
  };

  setField('req-from', 'from');
  setField('req-to', 'to');
  setField('req-date', 'date');
  setField('req-pax', 'pax');
  setField('req-interest', 'interest');

  if (params.get('trip') === 'oneway') {
    const oneway = document.getElementById('req-trip-oneway');
    if (oneway instanceof HTMLInputElement) oneway.checked = true;
  }

  // A collection or experience tile links here carrying what it was. Drop it
  // into the interest field and open the panel, so the choice is visibly
  // carried over rather than silently discarded.
  const interest = params.get('collection') ?? params.get('interest');
  const interestField = document.getElementById('req-interest');
  if (interest && interestField instanceof HTMLInputElement) {
    interestField.value = interest;
    document.getElementById('req-more')?.setAttribute('open', '');
  }

  const from = params.get('from');
  const to = params.get('to');
  const hint = document.getElementById('enquiry-hint');
  if (from && to && hint) {
    hint.textContent = `${from} to ${to}. A broker will reply with the options that fit.`;
  } else if (interest && hint) {
    hint.textContent = `${interest}. Tell us the dates and we will come back with what is possible.`;
  }
</script>
