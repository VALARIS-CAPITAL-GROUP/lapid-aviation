---
/** The standard interior-page opener: eyebrow, h1, standfirst, up to two CTAs. */
interface Props {
  eyebrow: string;
  heading: string;
  standfirst?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}

const { eyebrow, heading, standfirst, primary, secondary }: Props = Astro.props;
---

<section class="pt-[clamp(28px,3.5vw,44px)] pb-[clamp(40px,5vw,64px)]">
  <div class="shell">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-5 max-w-[880px] text-display">{heading}</h1>
    {
      standfirst && (
        <p class="mt-6 max-w-[700px] text-[18px] leading-[1.62] text-muted">{standfirst}</p>
      )
    }
    {
      (primary || secondary) && (
        <div class="mt-9 flex flex-wrap items-center gap-4">
          {primary && (
            <a
              href={primary.href}
              class="rounded-[2px] bg-navy px-7 py-4 text-[11.5px] font-semibold tracking-[0.13em] text-sand uppercase transition-all duration-200 ease-(--ease-out-expo) hover:-translate-y-[2px] hover:bg-copper hover:shadow-[0_10px_22px_rgba(16,27,45,0.22)]"
            >
              {primary.label}
            </a>
          )}
          {secondary && (
            <a
              href={secondary.href}
              class="border-b border-copper/40 pb-px text-[13.5px] font-medium text-copper transition-colors hover:border-copper hover:text-navy"
            >
              {secondary.label} &rarr;
            </a>
          )}
        </div>
      )
    }
  </div>
</section>
