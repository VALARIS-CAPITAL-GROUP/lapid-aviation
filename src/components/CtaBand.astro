---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { PAGES } from '~/data/site';

/**
 * The closing call to action. Pass an `image` for the full-bleed treatment;
 * without one it falls back to a flat navy band.
 */
interface Props {
  heading: string;
  body?: string;
  cta?: { label: string; href: string };
  image?: ImageMetadata;
  alt?: string;
  position?: string;
}

const {
  heading,
  body,
  cta = { label: 'Request a charter', href: PAGES.request.url },
  image,
  alt = '',
  position = 'center',
}: Props = Astro.props;
---

<section class="relative isolate overflow-hidden bg-navy">
  {
    image && (
      <>
        <Picture
          src={image}
          alt={alt}
          widths={[640, 1024, 1600, 2200]}
          sizes="100vw"
          formats={['avif']}
          fallbackFormat="webp"
          loading="lazy"
          class="absolute inset-0 -z-20 size-full object-cover"
          style={`object-position:${position}`}
        />
        <div class="absolute inset-0 -z-10 bg-navy/78" aria-hidden="true" />
      </>
    )
  }

  <div class="shell py-[clamp(64px,9vw,128px)] text-center" data-reveal>
    <h2 class="mx-auto max-w-[24ch] text-heading !text-white">{heading}</h2>
    {
      body && (
        <p class="mx-auto mt-5 max-w-[48ch] text-[15.5px] leading-[1.65] text-white/72">{body}</p>
      )
    }
    <a
      href={cta.href}
      class="mt-9 inline-block rounded-[2px] bg-copper px-8 py-4 text-[11.5px] font-semibold tracking-[0.13em] text-white uppercase transition-all duration-200 ease-(--ease-out-expo) hover:-translate-y-[2px] hover:bg-white hover:text-navy hover:shadow-[0_12px_28px_rgba(0,0,0,0.35)]"
    >
      {cta.label}
    </a>
  </div>
</section>
