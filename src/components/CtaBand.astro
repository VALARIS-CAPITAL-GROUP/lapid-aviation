---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { PAGES } from '~/data/site';

/**
 * The closing call to action. Pass an `image` for the full-bleed treatment;
 * without one it falls back to a flat charcoal band.
 */
interface Props {
  heading: string;
  body?: string;
  cta?: { label: string; href: string };
  image?: ImageMetadata;
  alt?: string;
  position?: string;
}

const {
  heading,
  body,
  cta = { label: 'Request a Charter', href: PAGES.request.url },
  image,
  alt = '',
  position = 'center',
}: Props = Astro.props;
---

<section class="on-dark relative isolate overflow-hidden bg-surface">
  {
    image && (
      <>
        <Image
          src={image}
          alt={alt}
          widths={[640, 1024, 1600, 2200]}
          sizes="100vw"
          format="webp"
          loading="lazy"
          class="absolute inset-0 -z-20 size-full object-cover"
          style={`object-position:${position}`}
        />
        <div class="absolute inset-0 -z-10 bg-surface/78" aria-hidden="true" />
      </>
    )
  }

  <div class="shell py-[clamp(64px,9vw,128px)] text-center" data-reveal>
    <h2 class="mx-auto max-w-[24ch] text-heading">{heading}</h2>
    {
      body && (
        <p class="mx-auto mt-5 max-w-[48ch] text-[15.5px] leading-[1.65] text-body">{body}</p>
      )
    }
    <a href={cta.href} class="cta mt-10">{cta.label}</a>
  </div>
</section>
