---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Words from '~/components/Words.astro';

/**
 * Full-bleed image hero. The image carries the page; type sits over a gradient
 * scrim so contrast holds regardless of what the photograph is doing underneath.
 *
 * `size` controls the height: `full` for the home page, `page` for interiors.
 */
interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow: string;
  heading: string;
  standfirst?: string;
  size?: 'full' | 'page';
  as?: 'h1' | 'h2';
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  /** Shift the visible crop when the subject is not centred. */
  position?: string;
}

const {
  image,
  alt,
  eyebrow,
  heading,
  standfirst,
  size = 'page',
  as: Heading = 'h1',
  primary,
  secondary,
  position = 'center',
}: Props = Astro.props;

const heights =
  size === 'full'
    ? 'min-h-[min(92svh,940px)] py-[clamp(96px,16vh,190px)]'
    : 'min-h-[min(62svh,620px)] py-[clamp(64px,10vh,120px)]';

// The hero is always the LCP element. It is the first thing in <body>, eager
// and fetchpriority=high, so the browser starts it immediately — a separate
// <link rel="preload"> would only risk a srcset mismatch and double download.
const widths = [640, 1024, 1600, 2200];
---

<section class:list={['relative isolate flex items-end overflow-hidden bg-charcoal', heights]}>
  <Image
    src={image}
    alt={alt}
    widths={widths}
    sizes="100vw"
    format="webp"
    loading="eager"
    fetchpriority="high"
    data-animate="pan"
    class="absolute inset-0 -z-20 size-full object-cover"
    style={`object-position:${position}`}
  />

  <!--
    Scrim: near-opaque at the bottom where the type sits, clearing toward the
    top. Heavy enough that the gold eyebrow reads against a bright sky — a
    lighter gradient left it washed out over pale cloud.
  -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-t from-obsidian via-obsidian/80 to-obsidian/40"
    aria-hidden="true"
  >
  </div>
  <!-- Side vignette, so type on the left always sits on the darkest area. -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-obsidian/85 via-obsidian/25 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="shell w-full">
    <p class="eyebrow" data-animate="rise">{eyebrow}</p>
    <span
      class="gold-rule mt-5"
      data-animate="rise"
      style="--animate-delay:80ms"
      aria-hidden="true"></span>
    <Heading
      class:list={[
        'mt-8 max-w-[14ch] text-balance !text-paper',
        size === 'full' ? 'text-mega' : 'text-display',
      ]}
    >
      <Words text={heading} stagger={size === 'full' ? 90 : 70} />
    </Heading>
    {
      standfirst && (
        <p
          data-animate="rise"
          style="--animate-delay:340ms"
          class="mt-8 max-w-[50ch] text-[17px] leading-[1.75] text-ash"
        >
          {standfirst}
        </p>
      )
    }
    {
      (primary || secondary) && (
        <div
          class="mt-11 flex flex-wrap items-center gap-x-9 gap-y-4"
          data-animate="rise"
          style="--animate-delay:460ms"
        >
          {primary && (
            <a href={primary.href} class="cta">
              {primary.label}
            </a>
          )}
          {secondary && (
            <a
              href={secondary.href}
              class="border-b border-white/30 pb-1 text-[13px] tracking-[0.02em] text-paper transition-colors duration-500 hover:border-gold-light hover:text-gold-light"
            >
              {secondary.label} &rarr;
            </a>
          )}
        </div>
      )
    }
  </div>
</section>
