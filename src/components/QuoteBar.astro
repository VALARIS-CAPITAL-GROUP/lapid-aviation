---
import { PAGES } from '~/data/site';

/**
 * The four-field enquiry opener from the design.
 *
 * A real GET form pointing at the enquiry page, so it works with no
 * JavaScript and arrives with the fields pre-filled. The trip-type segmented
 * control is a radio group styled with peer-checked — also zero JS.
 */
const fieldClass =
  'min-h-11 border-0 border-b border-white/20 bg-transparent py-[9px] text-[16px] text-paper outline-none focus:border-gold';
const labelClass = 'text-[10px] font-semibold tracking-[0.2em] text-ash uppercase';
---

<form
  method="get"
  action={PAGES.request.url}
  class="rounded-[3px] border border-white/12 bg-charcoal p-[26px_clamp(17px,4vw,28px)]"
>
  <fieldset class="mb-[18px] flex gap-[6px]">
    <legend class="sr-only">Trip type</legend>
    {
      [
        { value: 'return', label: 'Return', checked: true },
        { value: 'oneway', label: 'One-way', checked: false },
      ].map((option) => (
        <div>
          <input
            type="radio"
            name="trip"
            id={`trip-${option.value}`}
            value={option.value}
            checked={option.checked}
            class="peer sr-only"
          />
          {/* Checked state was `bg-charcoal` on a `bg-charcoal` form, so the
              selected pill was invisible. Graphite is the next surface up. */}
          <label
            for={`trip-${option.value}`}
            class="block cursor-pointer rounded-[20px] border border-transparent px-[14px] py-[6px] text-[11.5px] font-semibold text-ash transition-colors peer-checked:border-gold/40 peer-checked:bg-graphite peer-checked:text-paper peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-gold peer-focus-visible:outline-offset-2"
          >
            {option.label}
          </label>
        </div>
      ))
    }
  </fieldset>

  <div
    class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,148px),1fr))] items-end gap-5"
  >
    <div class="flex flex-col gap-2">
      <label class={labelClass} for="q-from">From</label>
      <input id="q-from" name="from" placeholder="London" autocomplete="off" class={fieldClass} />
    </div>
    <div class="flex flex-col gap-2">
      <label class={labelClass} for="q-to">To</label>
      <input id="q-to" name="to" placeholder="Geneva" autocomplete="off" class={fieldClass} />
    </div>
    <div class="flex flex-col gap-2">
      <label class={labelClass} for="q-date">Date</label>
      <input id="q-date" name="date" type="date" class={fieldClass} />
    </div>
    <div class="flex flex-col gap-2">
      <label class={labelClass} for="q-pax">Passengers</label>
      <input
        id="q-pax"
        name="pax"
        type="number"
        min="1"
        max="19"
        inputmode="numeric"
        placeholder="4"
        class={fieldClass}
      />
    </div>
    <button type="submit" class="cta flex min-h-12 cursor-pointer items-center justify-center !px-6">
      Plan Your Journey
    </button>
  </div>

  <p class="mt-5 text-[12.5px] text-ash">
    Four fields to open an enquiry. Everything else — the car, the stay, the reason you are
    going — is handled in conversation, not in a form.
  </p>
</form>
