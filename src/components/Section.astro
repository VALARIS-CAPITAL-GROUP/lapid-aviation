---
/**
 * Page section: optional eyebrow, gold rule, heading and standfirst.
 *
 * The palette is dark-dominant, so `surface` now means how dark rather than
 * which hue. `bone` is the single light surface and is used sparingly, so it
 * reads as a deliberate break rather than an alternating stripe.
 */
interface Props {
  eyebrow?: string;
  heading?: string;
  standfirst?: string;
  surface?: 'obsidian' | 'charcoal' | 'bone';
  /** Heading level — only one h1 per page. */
  as?: 'h1' | 'h2';
  /** Constrain the heading block to a readable measure. */
  narrow?: boolean;
  id?: string;
  class?: string;
}

const surfaces = {
  obsidian: 'bg-obsidian',
  charcoal: 'bg-charcoal',
  bone: 'bg-bone',
} as const;

const {
  eyebrow,
  heading,
  standfirst,
  surface = 'obsidian',
  as: Heading = 'h2',
  narrow = true,
  id,
  class: className,
}: Props = Astro.props;

const light = surface === 'bone';
---

{/* `on-light` flips the shared .cta / .cta-ghost / .cta-text styles to their
    dark-on-light variants. Without it a primary CTA inside a bone section
    would render bone-on-bone. */}
<section
  id={id}
  class:list={[surfaces[surface], light && 'on-light', 'py-[clamp(72px,10vw,150px)]', className]}
>
  <div class="shell">
    {
      (eyebrow || heading || standfirst) && (
        <div data-reveal class:list={['max-w-[820px]', narrow && 'mb-[clamp(44px,5.5vw,80px)]']}>
          {eyebrow && (
            <>
              <p class:list={['eyebrow', light && '!text-gold']}>{eyebrow}</p>
              <span class="gold-rule mt-5" aria-hidden="true" />
            </>
          )}
          {heading && (
            <Heading
              class:list={[
                eyebrow && 'mt-7',
                Heading === 'h1' ? 'text-display' : 'text-heading',
                light && '!text-ink',
              ]}
            >
              {heading}
            </Heading>
          )}
          {standfirst && (
            <p
              class:list={[
                'mt-6 max-w-measure text-[17px] leading-[1.7]',
                light ? 'text-ink-soft' : 'text-ash',
              ]}
            >
              {standfirst}
            </p>
          )}
        </div>
      )
    }
    <div data-reveal style="--reveal-delay:120ms">
      <slot />
    </div>
  </div>
</section>
