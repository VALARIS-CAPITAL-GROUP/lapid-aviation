---
/**
 * Page section: optional eyebrow, brass rule, heading and standfirst.
 *
 * The palette is light-dominant, so `surface` means which light tone by
 * default, with `dark` reserved for the occasional cinematic break. Because
 * every colour inside resolves through the semantic tokens, `dark` needs only
 * to add `on-dark` — nothing in the slot content has to change.
 */
interface Props {
  eyebrow?: string;
  heading?: string;
  standfirst?: string;
  /**
   * `light` is bone, `tint` is the warmer deeper bone used to alternate, and
   * `dark` is near-black for punctuation. Used sparingly — the point of a
   * light site is that the dark blocks land.
   */
  surface?: 'light' | 'tint' | 'dark';
  /** Heading level — only one h1 per page. */
  as?: 'h1' | 'h2';
  /** Constrain the heading block to a readable measure. */
  narrow?: boolean;
  id?: string;
  class?: string;
}

const surfaces = {
  light: 'bg-surface',
  tint: 'bg-surface-2',
  dark: 'on-dark bg-surface',
} as const;

const {
  eyebrow,
  heading,
  standfirst,
  surface = 'light',
  as: Heading = 'h2',
  narrow = true,
  id,
  class: className,
}: Props = Astro.props;
---

<section id={id} class:list={[surfaces[surface], 'py-[clamp(72px,10vw,150px)]', className]}>
  <div class="shell">
    {
      (eyebrow || heading || standfirst) && (
        <div data-reveal class:list={['max-w-[820px]', narrow && 'mb-[clamp(44px,5.5vw,80px)]']}>
          {eyebrow && (
            <>
              <p class="eyebrow">{eyebrow}</p>
              <span class="gold-rule mt-5" aria-hidden="true" />
            </>
          )}
          {heading && (
            <Heading
              class:list={[
                eyebrow && 'mt-7',
                Heading === 'h1' ? 'text-display' : 'text-heading',
              ]}
            >
              {heading}
            </Heading>
          )}
          {standfirst && (
            <p class="mt-6 max-w-measure text-[17px] leading-[1.7] text-body">{standfirst}</p>
          )}
        </div>
      )
    }
    <div data-reveal style="--reveal-delay:120ms">
      <slot />
    </div>
  </div>
</section>
