---
import { MARKET_RATES, MARKET_RATES_NOTE, type MarketRate } from '~/data/content';

/**
 * Indicative market rates per flying hour.
 *
 * The competitor review found the London market split between sites that
 * publish nothing on price and sites that publish one fake-precise total per
 * route. Both leave the reader unable to judge whether to enquire. This block
 * takes the third option: honest ranges, their provenance stated, and an
 * explicit reminder that they are not a quote.
 *
 * Pass `categories` to show only the rows relevant to a route.
 */
interface Props {
  /** Category names to include, in display order. Omit for all of them. */
  categories?: string[];
  /** Hide the provenance note where the page already carries it. */
  note?: boolean;
}

const { categories, note = true }: Props = Astro.props;

const rows: MarketRate[] = categories
  ? categories
      .map((name) => MARKET_RATES.find((rate) => rate.category === name))
      .filter((rate): rate is MarketRate => Boolean(rate))
  : MARKET_RATES;

const money = (value: number) => `£${value.toLocaleString('en-GB')}`;
---

<div>
  <!-- A real <table>: this is tabular data, and it wants to be read across. -->
  <table class="w-full border-collapse text-left">
    <caption class="sr-only">
      Indicative UK private jet charter rates per flying hour by aircraft category
    </caption>
    <thead>
      <tr class="border-b border-rule">
        <th scope="col" class="eyebrow !text-muted pb-3 pr-6">Category</th>
        <th scope="col" class="eyebrow !text-muted pb-3 pr-6 whitespace-nowrap">Per flying hour</th>
        <th scope="col" class="eyebrow !text-muted hidden pb-3 sm:table-cell">Usually the answer for</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((rate) => (
          <tr class="border-b border-rule align-top">
            <th scope="row" class="py-5 pr-6 font-display text-[18px] font-normal leading-[1.3] text-title">
              {rate.category}
            </th>
            <td class="py-5 pr-6 whitespace-nowrap font-display text-[18px] tabular-nums text-accent">
              {money(rate.low)} &ndash; {money(rate.high)}
            </td>
            <td class="hidden py-5 text-[14.5px] leading-[1.65] text-body sm:table-cell">
              {rate.suits}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>

  {
    note && (
      <p class="mt-6 max-w-measure text-[13.5px] leading-[1.7] text-muted">{MARKET_RATES_NOTE}</p>
    )
  }
</div>
