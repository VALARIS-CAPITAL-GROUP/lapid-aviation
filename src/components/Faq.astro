---
import type { Faq } from '~/data/content';

/**
 * FAQ accordion. Uses native <details> so it needs no JavaScript and stays
 * open/closed accessibly. Emit FAQPage JSON-LD alongside it with faqSchema().
 */
interface Props {
  items: Faq[];
  surface?: 'light' | 'navy';
}

const { items, surface = 'light' } = Astro.props;
const dark = surface === 'navy';
---

<div class:list={['border-t', dark ? 'border-white/12' : 'border-line']}>
  {
    items.map((item) => (
      <details class:list={['group border-b', dark ? 'border-white/12' : 'border-line']}>
        <summary
          class="flex cursor-pointer list-none items-start justify-between gap-6 py-[22px] [&::-webkit-details-marker]:hidden"
        >
          <span
            class:list={[
              'font-serif text-[19px] leading-[1.35]',
              dark ? 'text-sand' : 'text-navy',
            ]}
          >
            {item.q}
          </span>
          <span
            class:list={[
              'mt-1 shrink-0 text-[20px] leading-none transition-transform duration-200 group-open:rotate-45',
              dark ? 'text-copper-light' : 'text-copper',
            ]}
            aria-hidden="true"
          >
            +
          </span>
        </summary>
        <p
          class:list={[
            'max-w-measure pb-[26px] text-[15px] leading-[1.68]',
            dark ? 'text-[#a9b2bf]' : 'text-muted',
          ]}
        >
          {item.a}
        </p>
      </details>
    ))
  }
</div>
