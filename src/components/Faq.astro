---
import type { Faq } from '~/data/content';

/**
 * FAQ accordion. Uses native <details> so it needs no JavaScript and stays
 * open/closed accessibly. Emit FAQPage JSON-LD alongside it with faqSchema().
 *
 * Previously took a `surface` prop whose two branches resolved to identical
 * classes. Colours now come from the semantic tokens, so the accordion adapts
 * to whatever surface it is placed on without being told.
 */
interface Props {
  items: Faq[];
}

const { items }: Props = Astro.props;
---

<div data-reveal-group class="border-t border-rule">
  {
    items.map((item) => (
      <details class="group border-b border-rule">
        <summary
          class="flex cursor-pointer list-none items-start justify-between gap-6 py-[22px] [&::-webkit-details-marker]:hidden"
        >
          <span class="font-display text-[19px] leading-[1.35] text-title">{item.q}</span>
          <span
            class="mt-1 shrink-0 text-[20px] leading-none text-accent transition-transform duration-200 group-open:rotate-45"
            aria-hidden="true"
          >
            +
          </span>
        </summary>
        <p class="max-w-measure pb-[26px] text-[15px] leading-[1.68] text-body">{item.a}</p>
      </details>
    ))
  }
</div>
