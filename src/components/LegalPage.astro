---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import type { PageMeta } from '~/data/site';

/**
 * Shared shell for the two legal pages.
 *
 * Both are structural placeholders in the approved design, pending a
 * solicitor's review. The notice below is deliberately NOT dev-only — unlike
 * the editorial research flags, shipping unreviewed legal text with no visible
 * caveat would be worse than showing one. Both pages are also `noindex` until
 * the review lands.
 */
interface Props {
  meta: PageMeta;
  title: string;
  notice: string;
  sections: { heading: string; body: string }[];
  seeAlso: { label: string; href: string };
}

const { meta, title, notice, sections, seeAlso }: Props = Astro.props;
---

<Layout meta={meta} noindex>
  <Breadcrumb trail={[{ name: title, url: meta.url }]} />

  <section class="pt-[clamp(28px,3.5vw,44px)] pb-[clamp(52px,7vw,84px)]">
    <div class="shell max-w-[820px]">
      <p class="eyebrow">Legal</p>
      <h1 class="mt-5 text-heading">{title}</h1>

      <aside class="mt-8 rounded-[3px] border border-copper/40 bg-copper/6 p-6">
        <p class="eyebrow">Awaiting legal review</p>
        <p class="mt-3 text-[14px] leading-[1.65] text-slate">{notice}</p>
      </aside>

      <div class="mt-12 space-y-10">
        {
          sections.map((section) => (
            <section>
              <h2 class="font-serif text-[21px] leading-[1.3]">{section.heading}</h2>
              <p class="mt-3 text-[15px] leading-[1.72] text-slate">{section.body}</p>
            </section>
          ))
        }
      </div>

      <p class="mt-14 border-t border-line pt-6 text-[14px] text-muted">
        See also our <a
          href={seeAlso.href}
          class="text-copper transition-colors hover:text-navy">{seeAlso.label}</a
        >.
      </p>
    </div>
  </section>
</Layout>
