---
import { breadcrumbSchema } from '~/lib/schema';

/**
 * Breadcrumb trail. Pass every ancestor plus the current page; the last item
 * renders as plain text rather than a link.
 */
interface Props {
  trail: { name: string; url: string }[];
}

const { trail }: Props = Astro.props;
const items = [{ name: 'Home', url: '/' }, ...trail];
const last = items.length - 1;
---

<nav aria-label="Breadcrumb" class="shell pt-7">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[11.5px] text-muted">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          {i === last ? (
            <span aria-current="page" class="text-navy">
              {item.name}
            </span>
          ) : (
            <>
              <a href={item.url} class="transition-colors hover:text-copper">
                {item.name}
              </a>
              <span aria-hidden="true" class="text-line-strong">
                &rarr;
              </span>
            </>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<script
  type="application/ld+json"
  set:html={JSON.stringify(breadcrumbSchema(items))}
  is:inline
/>
