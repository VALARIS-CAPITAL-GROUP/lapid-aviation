---
import { SITE } from '~/data/site';

interface Props {
  title: string;
  description: string;
  /** Canonical path, e.g. "/private-jets/". Defaults to the current URL. */
  path?: string;
  /** Set for the legal pages and any thin/duplicate page we don't want indexed. */
  noindex?: boolean;
  /** Extra JSON-LD blocks (FAQPage, Service, BreadcrumbList...). */
  schema?: unknown[];
}

const { title, description, path, noindex = false, schema = [] } = Astro.props;

const canonical = new URL(path ?? Astro.url.pathname, SITE.url).href;

// The broker entity. Repeated on every page so the Organization is
// unambiguous — this is a trust-sensitive niche and the design leans hard on
// "independent broker, not an operator".
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: `${SITE.url}/`,
  description: SITE.tagline,
  areaServed: { '@type': 'City', name: 'London' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.locality,
    addressCountry: SITE.country,
  },
};

const blocks = [organization, ...schema];
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_GB" />
<meta name="twitter:card" content="summary_large_image" />

{
  blocks.map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />
  ))
}
