---
import { SITE } from '~/data/site';

interface Props {
  title: string;
  description: string;
  /** Canonical path, e.g. "/private-jets/". Defaults to the current URL. */
  path?: string;
  /** Set for the legal pages and any thin/duplicate page we don't want indexed. */
  noindex?: boolean;
  /** Extra JSON-LD blocks (FAQPage, Service, BreadcrumbList...). */
  schema?: unknown[];
}

const { title, description, path, noindex = false, schema = [] }: Props = Astro.props;

const canonical = new URL(path ?? Astro.url.pathname, SITE.url).href;

/**
 * Open Graph image. Generated by `npm run og` into public/og/, keyed by the
 * canonical path with slashes flattened to dashes — so /private-jets/cost/
 * becomes private-jets-cost.jpg. Falls back to default.jpg.
 */
const ogSlug = (path ?? Astro.url.pathname).replace(/^\/|\/$/g, '').replace(/\//g, '-') || 'home';
const ogImage = new URL(`/og/${ogSlug}.jpg`, SITE.url).href;

// The broker entity. Repeated on every page so the Organization is
// unambiguous — this is a trust-sensitive niche and the design leans hard on
// "independent broker, not an operator".
const organization = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'TravelAgency'],
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: `${SITE.url}/`,
  description: SITE.tagline,
  image: ogImage,
  areaServed: { '@type': 'City', name: 'London' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.locality,
    addressCountry: SITE.country,
  },
  // No telephone or email yet: the design has all three "to be confirmed",
  // and inventing them would put false contact data into structured data.
  knowsAbout: [
    'Private jet charter',
    'Helicopter charter',
    'Business aviation',
    'Aircraft operator safety vetting',
  ],
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: `${SITE.url}/`,
  name: SITE.name,
  inLanguage: 'en-GB',
  publisher: { '@id': `${SITE.url}/#organization` },
};

const blocks = [organization, website, ...schema];
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{
  noindex ? (
    <meta name="robots" content="noindex, follow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large" />
  )
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_GB" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${title} — ${SITE.name}`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{
  blocks.map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />
  ))
}
