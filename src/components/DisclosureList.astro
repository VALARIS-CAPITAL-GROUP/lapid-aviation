---
/**
 * The "summary line, expand for detail" list used for aircraft categories,
 * business sectors and cost factors. Native <details>, so no JavaScript.
 */
interface Props {
  items: {
    /** Optional leading number, e.g. "01". */
    n?: string;
    name: string;
    /** The always-visible summary line. */
    line: string;
    /** Revealed on expand. */
    more: string;
    /** Small label on the summary row, e.g. "Specification to verify". */
    tag?: string;
  }[];
}

const { items }: Props = Astro.props;
---

<div data-reveal-group class="border-t border-hair">
  {
    items.map((item) => (
      <details class="group border-b border-hair">
        <summary
          class="grid cursor-pointer list-none grid-cols-[1fr_auto] items-start gap-x-6 py-6 [&::-webkit-details-marker]:hidden"
        >
          <div>
            <h3 class="font-display text-[21px] leading-[1.3]">
              {item.n && (
                <span class="mr-3 align-middle text-[13px] tabular-nums text-gold-light">
                  {item.n}
                </span>
              )}
              {item.name}
            </h3>
            <p class="mt-2 max-w-[720px] text-[14.5px] leading-[1.65] text-ash">{item.line}</p>
            {item.tag && (
              <p class="mt-3 text-[9.5px] font-semibold tracking-[0.16em] text-slate uppercase">
                {item.tag}
              </p>
            )}
          </div>
          <span
            class="mt-1 shrink-0 text-[20px] leading-none text-gold-light transition-transform duration-200 group-open:rotate-45"
            aria-hidden="true">+</span
          >
        </summary>
        <p class="max-w-measure pb-7 text-[14.5px] leading-[1.68] text-ash">{item.more}</p>
      </details>
    ))
  }
</div>
