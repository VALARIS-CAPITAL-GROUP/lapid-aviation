---
import { NAV, PAGES, CONTACT, contactHref } from '~/data/site';

// Falls back to the contact page for any method not supplied yet, so the strip
// is never a dead `tel:` link. Fill in CONTACT in site.ts and these become
// real click-to-call / WhatsApp / mail links with no change here.
const quickContact = [
  { label: 'Call', method: 'phone' as const, set: Boolean(CONTACT.phone) },
  { label: 'WhatsApp', method: 'whatsapp' as const, set: Boolean(CONTACT.whatsapp) },
  { label: 'Email', method: 'email' as const, set: Boolean(CONTACT.email) },
];

// Trailing-slash-insensitive compare so /private-jets and /private-jets/ both match.
const here = '/' + Astro.url.pathname.replace(/^\/|\/$/g, '');
const isCurrent = (href: string) => '/' + href.replace(/^\/|\/$/g, '') === here;
---

<header
  transition:name="site-header"
  transition:animate="none"
  class="sticky top-0 z-50 border-b border-rule bg-surface/90 backdrop-blur-xl"
>
  <!-- Contact strip. Driven by CONTACT in site.ts: real links once supplied,
       the contact page until then, never an invented number. -->
  <div class="border-b border-rule">
    <div class="shell flex h-9 items-center justify-end gap-7 text-[11px] tracking-[0.08em]">
      {
        quickContact.map((item) => (
          <a
            href={contactHref(item.method)}
            class="text-muted transition-colors hover:text-accent"
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </div>

  <div class="shell flex h-20 items-center gap-[clamp(16px,3.5vw,44px)]">
    <a href="/" class="mr-auto flex flex-col gap-1" aria-label="Lapid Aviation — home">
      <span class="font-display text-[26px] leading-none tracking-[0.01em] text-title">Lapid</span>
      <span class="text-[8px] font-semibold tracking-[0.42em] text-accent">AVIATION</span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-[clamp(18px,2.6vw,32px)]">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  'relative block py-2 text-[13px] tracking-[0.02em] transition-colors duration-300',
                  'after:absolute after:inset-x-0 after:-bottom-px after:h-px after:origin-left after:bg-accent after:transition-transform after:duration-500 after:ease-(--ease-out-expo)',
                  isCurrent(item.href)
                    ? 'text-title after:scale-x-100'
                    : 'text-body after:scale-x-0 hover:text-title hover:after:scale-x-100',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href={PAGES.request.url} class="cta-ghost hidden !px-6 !py-3.5 sm:block">
      Request a Charter
    </a>

    <!-- Mobile menu: a disclosure, so it works with JS disabled -->
    <details class="group lg:hidden [&[open]_.menu-open]:hidden [&[open]_.menu-close]:block">
      <summary
        class="flex size-11 cursor-pointer list-none items-center justify-center rounded-[1px] border border-rule text-title [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
      >
        <svg class="menu-open size-5" viewBox="0 0 20 20" aria-hidden="true" fill="none">
          <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="1.2"></path>
        </svg>
        <svg class="menu-close hidden size-5" viewBox="0 0 20 20" aria-hidden="true" fill="none">
          <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.2"></path>
        </svg>
      </summary>

      <nav
        aria-label="Primary (mobile)"
        class="absolute inset-x-0 top-full border-b border-rule bg-surface shadow-[0_24px_48px_rgba(20,17,15,0.14)]"
      >
        <ul class="shell divide-y divide-rule py-2">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  class:list={[
                    'block py-4 text-[15px]',
                    isCurrent(item.href) ? 'text-accent' : 'text-body',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="pt-5 pb-4">
            <a href={PAGES.request.url} class="cta block w-full text-center">
              Request a Charter
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>
