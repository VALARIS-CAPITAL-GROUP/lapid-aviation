---
import { NAV, PAGES } from '~/data/site';

// Trailing-slash-insensitive compare so /private-jets and /private-jets/ both match.
const here = '/' + Astro.url.pathname.replace(/^\/|\/$/g, '');
const isCurrent = (href: string) => '/' + href.replace(/^\/|\/$/g, '') === here;
---

<header
  transition:name="site-header"
  transition:animate="none"
  class="sticky top-0 z-50 border-b border-white/8 bg-obsidian/90 backdrop-blur-xl"
>
  <!-- Contact strip. Real phone/WhatsApp/email are still "to be confirmed" in
       the design, so these point at the contact page rather than at invented
       details. -->
  <div class="border-b border-white/6">
    <div class="shell flex h-9 items-center justify-end gap-7 text-[11px] tracking-[0.08em]">
      <a href="/contact/" class="text-slate transition-colors hover:text-gold-light">Call</a>
      <a href="/contact/" class="text-slate transition-colors hover:text-gold-light">WhatsApp</a>
      <a href="/contact/" class="text-slate transition-colors hover:text-gold-light">Email</a>
    </div>
  </div>

  <div class="shell flex h-20 items-center gap-[clamp(16px,3.5vw,44px)]">
    <a href="/" class="mr-auto flex flex-col gap-1" aria-label="Lapid Aviation — home">
      <span class="font-display text-[26px] leading-none tracking-[0.01em] text-paper">Lapid</span>
      <span class="text-[8px] font-semibold tracking-[0.42em] text-gold-light">AVIATION</span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-[clamp(18px,2.6vw,32px)]">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  'relative block py-2 text-[13px] tracking-[0.02em] transition-colors duration-300',
                  'after:absolute after:inset-x-0 after:-bottom-px after:h-px after:origin-left after:bg-gold-light after:transition-transform after:duration-500 after:ease-(--ease-out-expo)',
                  isCurrent(item.href)
                    ? 'text-paper after:scale-x-100'
                    : 'text-ash after:scale-x-0 hover:text-paper hover:after:scale-x-100',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href={PAGES.request.url}
      class="hidden rounded-[1px] border border-gold/70 px-6 py-3.5 text-[10.5px] font-semibold tracking-[0.18em] whitespace-nowrap text-gold-light uppercase transition-all duration-500 ease-(--ease-out-expo) hover:border-gold hover:bg-gold hover:text-white sm:block"
    >
      Request Charter
    </a>

    <!-- Mobile menu: a disclosure, so it works with JS disabled -->
    <details class="group lg:hidden [&[open]_.menu-open]:hidden [&[open]_.menu-close]:block">
      <summary
        class="flex size-11 cursor-pointer list-none items-center justify-center rounded-[1px] border border-white/20 text-paper [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
      >
        <svg class="menu-open size-5" viewBox="0 0 20 20" aria-hidden="true" fill="none">
          <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="1.2"></path>
        </svg>
        <svg class="menu-close hidden size-5" viewBox="0 0 20 20" aria-hidden="true" fill="none">
          <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.2"></path>
        </svg>
      </summary>

      <nav
        aria-label="Primary (mobile)"
        class="absolute inset-x-0 top-full border-b border-white/10 bg-obsidian shadow-[0_24px_48px_rgba(0,0,0,0.6)]"
      >
        <ul class="shell divide-y divide-white/8 py-2">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  class:list={[
                    'block py-4 text-[15px]',
                    isCurrent(item.href) ? 'text-gold-light' : 'text-ash',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="pt-5 pb-4">
            <a
              href={PAGES.request.url}
              class="block rounded-[1px] bg-gold px-5 py-4 text-center text-[10.5px] font-semibold tracking-[0.18em] text-white uppercase"
            >
              Request Charter
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>
