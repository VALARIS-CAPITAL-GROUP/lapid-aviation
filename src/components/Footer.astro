---
import { FOOTER_GROUPS, PAGES, SITE } from '~/data/site';

const year = new Date().getFullYear();

// Derived from the data rather than hardcoded: the column count was fixed at
// four and silently wrapped when a fifth link group was added.
const columns = `1.2fr repeat(${FOOTER_GROUPS.length}, 1fr)`;
---

<footer class="on-dark mt-auto bg-surface-2 text-body">
  <div class="shell py-[clamp(48px,7vw,84px)]">
    <div class="grid gap-y-12 gap-x-8 sm:grid-cols-2 lg:grid-cols-(--footer-cols)" style={`--footer-cols:${columns}`}>
      <div class="max-w-[300px] sm:col-span-2 lg:col-span-1">
        <a href="/" class="flex flex-col gap-[3px]" aria-label="Lapid Aviation — home">
          <span class="font-display text-[23px] leading-none tracking-[0.02em] text-title">Lapid</span>
          <span class="text-[8.5px] font-semibold tracking-[0.34em] text-accent"
            >AVIATION</span
          >
        </a>
        <p class="mt-5 text-[13.5px] leading-[1.65]">
          {SITE.tagline} We own no aircraft. Every flight is operated by a licensed air carrier
          we have vetted for the trip.
        </p>
        <a href={PAGES.vetting.url} class="cta-text mt-4">How we vet operators</a>
      </div>

      {
        FOOTER_GROUPS.map((group) => (
          <nav aria-label={group.heading}>
            <h2 class="eyebrow !text-accent">{group.heading}</h2>
            <ul class="mt-5 space-y-[11px]">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[13.5px] transition-colors hover:text-title"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-[clamp(40px,5vw,64px)] flex flex-col gap-4 border-t border-rule pt-8 text-[11.5px] text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {SITE.name}. All rights reserved.</p>
      <p class="max-w-[520px] sm:text-right">
        Lapid Aviation acts as an agent for the charterer and is not an air carrier or operator.
      </p>
    </div>
  </div>
</footer>
