---
import { FOOTER_GROUPS, PAGES, SITE } from '~/data/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto bg-navy text-[#a9b2bf]">
  <div class="shell py-[clamp(48px,7vw,84px)]">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_repeat(4,1fr)]">
      <div class="max-w-[300px]">
        <a href="/" class="flex flex-col gap-[3px]" aria-label="Lapid Aviation — home">
          <span class="font-serif text-[23px] leading-none tracking-[0.02em] text-sand">Lapid</span>
          <span class="text-[8.5px] font-semibold tracking-[0.34em] text-copper-light"
            >AVIATION</span
          >
        </a>
        <p class="mt-5 text-[13.5px] leading-[1.65]">
          {SITE.tagline} We own no aircraft. Every flight is operated by a licensed air carrier
          we have vetted for the trip.
        </p>
        <a
          href={PAGES.vetting.url}
          class="mt-4 inline-block border-b border-copper-light/40 pb-px text-[13px] text-copper-light transition-colors hover:border-copper-light hover:text-sand"
        >
          How we vet operators
        </a>
      </div>

      {
        FOOTER_GROUPS.map((group) => (
          <nav aria-label={group.heading}>
            <h2 class="eyebrow !text-copper-light">{group.heading}</h2>
            <ul class="mt-5 space-y-[11px]">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[13.5px] transition-colors hover:text-sand"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-[clamp(40px,5vw,64px)] flex flex-col gap-4 border-t border-white/10 pt-8 text-[11.5px] text-faint sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {SITE.name}. All rights reserved.</p>
      <p class="max-w-[520px] sm:text-right">
        Lapid Aviation acts as an agent for the charterer and is not an air carrier or operator.
      </p>
    </div>
  </div>
</footer>
